// ==========================================
// stabl/build.staff
// STABL: Simple Typeless Artifact Boot Loader
// ==========================================

artifact stabl [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/boot_defs.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
