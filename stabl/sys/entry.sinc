// ==========================================
// stabl/sys/entry.sinc
// Simple Typeless Artifact Boot Loader (STABL)
// Hardware detection, UEFI severance, and kernel handoff
// ==========================================

fn pci_read32!(bus, dev, fn_num, reg) [
    addr = 2147483648 | (bus << 16) | (dev << 11) | (fn_num << 8) | (reg & 252);
    io_out32!(PCI_CONFIG_ADDRESS, addr);
    val = io_in32!(PCI_CONFIG_DATA);
    ret val;
]

fn pci_write32!(bus, dev, fn_num, reg, val) [
    addr = 2147483648 | (bus << 16) | (dev << 11) | (fn_num << 8) | (reg & 252);
    io_out32!(PCI_CONFIG_ADDRESS, addr);
    io_out32!(PCI_CONFIG_DATA, val);
    ret 0;
]

fn stabl_main!(image_handle, system_table, image_base, bss_base) [
    // 1. Telemetry and BSS pointer layout
    cpu_caps = 1; // AVX-512 guaranteed active by _efi_entry

    slot_map_size  = bss_base;
    slot_map_key   = bss_base + 8;
    slot_desc_size = bss_base + 16;
    slot_desc_ver  = bss_base + 24;
    slot_gop_out   = bss_base + 32;
    slot_guid      = bss_base + 40;
    mem_map_buf    = bss_base + 64;
    ram_tape       = bss_base + 49216;

    // 2. Step B: Query Graphics Output Protocol (GOP)
    slot_guid@[0] = GUID_GOP_W0;
    slot_guid@[1] = GUID_GOP_W1;
    slot_gop_out@[0] = 0;

    bs = system_table@[SYSTEM_TABLE_BOOT_SERVICES];
    locate_proto_fn = bs@[BOOT_SERVICES_LOCATE_PROTOCOL];
    status = efi_call5!(locate_proto_fn, slot_guid, 0, slot_gop_out, 0, 0);
    if (status != 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_NOT_FOUND);
        ret 1;
    ]

    gop = slot_gop_out@[0];
    if (gop == 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_NOT_FOUND);
        ret 1;
    ]

    gop_mode = gop@[GOP_MODE];
    if (gop_mode == 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_NOT_FOUND);
        ret 1;
    ]

    fb_base = gop_mode@[MODE_FB_BASE];
    if (fb_base == 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_NOT_FOUND);
        ret 1;
    ]

    gop_info = gop_mode@[MODE_INFO];
    if (gop_info == 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_NOT_FOUND);
        ret 1;
    ]

    horiz_res = (gop_info@[0] >> 32) & 4294967295;
    vert_res = gop_info@[1] & 4294967295;
    pixel_format = (gop_info@[1] >> 32) & 4294967295;

    // Fail-fast if PixelBltOnly (unsupported)
    if (pixel_format == 3) [
        io_out32!(TRG_DEBUG_PORT, ERR_GOP_BLT_ONLY);
        ret 1;
    ]

    pixels_per_scanline = gop_info@[INFO_STRIDE] & 4294967295;
    fb_stride = pixels_per_scanline << 2;
    dims = (horiz_res << 32) | vert_res;

    // 3. Step C: PCI Probing for Mass Storage (NVMe / AHCI)
    storage_bar = 0;
    loop (bus:256 = 0 .. 256) [
        if (storage_bar == 0) [
            loop (dev:32 = 0 .. 32) [
                if (storage_bar == 0) [
                    v0 = pci_read32!(bus, dev, 0, 0);
                    vendor = v0 & 65535;
                    if (vendor != 65535) [
                        hdr = pci_read32!(bus, dev, 0, 12);
                        max_fn = 1;
                        if (((hdr >> 16) & 128) != 0) [
                            max_fn = 8;
                        ]
                        loop (fn_idx:8 = 0 .. max_fn) [
                            if (storage_bar == 0) [
                                v_fn = pci_read32!(bus, dev, fn_idx, 0);
                                if ((v_fn & 65535) != 65535) [
                                    class_reg = pci_read32!(bus, dev, fn_idx, 8);
                                    class_code = (class_reg >> 8) & 16777215;

                                    if (class_code == PCI_CLASS_NVME) [
                                        bar0 = pci_read32!(bus, dev, fn_idx, 16);
                                        bar_lo = bar0 & BAR_MMIO_MASK;
                                        bar_hi = 0;
                                        if ((bar0 & 6) == 4) [
                                            bar_hi = pci_read32!(bus, dev, fn_idx, 20);
                                        ]
                                        storage_bar = (bar_hi << 32) | bar_lo;
                                        cpu_caps = cpu_caps | 2;
                                    ] else [
                                        if (class_code == PCI_CLASS_AHCI) [
                                            bar5 = pci_read32!(bus, dev, fn_idx, 36);
                                            storage_bar = bar5 & BAR_MMIO_MASK;
                                        ]
                                    ]
                                    if (storage_bar != 0) [
                                        cmd = pci_read32!(bus, dev, fn_idx, 4);
                                        pci_write32!(bus, dev, fn_idx, 4, cmd | PCI_CMD_MMIO_BM);
                                    ]
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]

    if (storage_bar == 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_NO_STORAGE);
        ret 1;
    ]

    // 4. Step D: Single-Shot GetMemoryMap & ExitBootServices
    slot_map_size@[0] = 49152;
    get_mem_map_fn = bs@[BOOT_SERVICES_GET_MEMORY_MAP];
    status = efi_call5!(get_mem_map_fn, slot_map_size, mem_map_buf, slot_map_key, slot_desc_size, slot_desc_ver);
    if (status != 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_MEM_MAP_FAIL);
        ret 1;
    ]

    map_key = slot_map_key@[0];
    exit_bs_fn = bs@[BOOT_SERVICES_EXIT_BOOT_SERVICES];
    status = efi_call5!(exit_bs_fn, image_handle, map_key, 0, 0, 0);
    if (status != 0) [
        io_out32!(TRG_DEBUG_PORT, ERR_EXIT_BS_FAIL);
        ret 1;
    ]

    // 5. Step E: Compact RAM Tape and Jump to SINC Exokernel
    map_size = slot_map_size@[0];
    desc_size = slot_desc_size@[0];
    region_count = compact_ram_tape!(mem_map_buf, map_size, desc_size, ram_tape);

    stride_caps = (fb_stride << 32) | cpu_caps;
    stabl_jump_kernel!(fb_base, dims, stride_caps, ram_tape, region_count, storage_bar);
    ret 0;
]
