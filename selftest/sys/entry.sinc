// ==========================================
// selftest/sys/entry.sinc
// Sovereign Hardware Invariant Proof Cell (Strict Law 15)
// ==========================================

fn test_pmm!(arena) [
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    p2 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((p1 == 0) | (p2 == 0) | (p1 == p2)) [
        ret 1;
    ]
    f_res = exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    p3 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p2, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p3, 1, 0, 0);
    if ((f_res != 0) | (p3 != p1)) [
        ret 2;
    ]
    ret 0;
]

fn test_caps!(arena) [
    cap_table = arena@[ARENA_LENS_CAP_TABLE];
    live_mask_ptr = arena@[ARENA_LENS_LIVE_MASK];

    sip_id = cap_sip_alloc!(live_mask_ptr);
    if (sip_id != 0) [
        ret 3;
    ]
    token = cap_mint!(cap_table, 0, sip_id);
    live_mask = live_mask_ptr@[0];
    v1 = cap_validate_token(token, cap_table, live_mask);
    if (v1 != 1) [
        ret 4;
    ]
    cap_revoke!(cap_table, 0);
    v2 = cap_validate_token(token, cap_table, live_mask);
    if (v2 != 0) [
        ret 5;
    ]
    cap_sip_free!(live_mask_ptr, sip_id);
    ret 0;
]

fn test_nvme_case!(arena) [
    write_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    read_buf  = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    loop (z:512 = 0 .. 512) [
        write_buf@[z] = 0;
        read_buf@[z] = 0;
    ]
    write_buf@[0] = -77074246535541692;
    write_buf@[1] = 1337;

    tmp_n0 = 1397296901;
    h1 = case_fnv1a_64(write_buf, 64);
    w1 = case_write_file!(arena, CASE_TYPE_DATA, tmp_n0, 0, write_buf, 64);
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    f1 = case_find_artifact!(arena, tmp_n0, 0, ext_buf);
    pg1 = ext_buf@[CASE_EXT_PG];
    ep1 = case_entry_epoch(ext_buf@[CASE_EXT_META]);
    ty1 = case_entry_type(ext_buf@[CASE_EXT_META]);
    hs1 = ext_buf@[CASE_EXT_HASH];
    r1 = case_rw_pages!(arena, 0, pg1, 1, read_buf);
    m1 = read_buf@[0];
    t1 = read_buf@[1];

    write_buf@[1] = 7331;
    h2 = case_fnv1a_64(write_buf, 64);
    w2 = case_write_file!(arena, CASE_TYPE_DATA, tmp_n0, 0, write_buf, 64);
    f2 = case_find_artifact!(arena, tmp_n0, 0, ext_buf);
    pg2 = ext_buf@[CASE_EXT_PG];
    ep2 = case_entry_epoch(ext_buf@[CASE_EXT_META]);
    hs2 = ext_buf@[CASE_EXT_HASH];
    r2 = case_rw_pages!(arena, 0, pg2, 1, read_buf);
    t2 = read_buf@[1];

    d_res = case_delete_file!(arena, tmp_n0, 0);
    gone_res = case_find_artifact!(arena, tmp_n0, 0, ext_buf);

    exocall!(arena, EXOCALL_PMM_FREE, write_buf, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, read_buf, 1, 0, 0);

    if ((w1 != 0) | (f1 != 0) | (r1 != 0) | (w2 != 0) | (f2 != 0) | (r2 != 0) | (d_res != 0) | (!(gone_res < 0))) [
        ret 6;
    ]
    if ((ty1 != CASE_TYPE_DATA) | (ep1 != 1) | (hs1 != h1) | (m1 != -77074246535541692) | (t1 != 1337)) [
        ret 6;
    ]
    if ((pg2 == pg1) | (ep2 != 2) | (hs2 != h2) | (t2 != 7331)) [
        ret 6;
    ]
    ret 0;
]

fn test_ring!(arena) [
    ring_ptr = arena@[ARENA_LENS_RING];
    // Verify negative packed fields stay >= 0 cleanly (pad==0 protects < 0 sentinel)
    k_ev = input_evt_pack(EVT_KEY_DOWN, MOD_LSHIFT, TRG_RET, -35, -1);
    if ((k_ev < 0) | (input_evt_type(k_ev) != EVT_KEY_DOWN) | (input_evt_mods(k_ev) != MOD_LSHIFT) | (input_evt_key(k_ev) != TRG_RET) | (input_evt_aux(k_ev) != -1)) [
        ret 7;
    ]
    r_push = ring_push!(ring_ptr, k_ev);
    pop_val = ring_pop!(ring_ptr);
    empty_val = ring_pop!(ring_ptr);
    head = ring_ptr@[RING_LENS_HEAD];
    tail = ring_ptr@[RING_LENS_TAIL];
    if ((r_push != 0) | (pop_val != k_ev) | (!(empty_val < 0)) | (head != tail)) [
        ret 7;
    ]
    ret 0;
]

fn test_xhci_hid!(arena) [
    // Direct HID Usage -> Pure TRG mapping check (a, A, Enter, Space, BS, ArrowUp, unmapped)
    trg_err = (hid_usage_to_trg(4, 0) != 26) | (hid_usage_to_trg(4, MOD_LSHIFT) != 0) | (hid_usage_to_trg(40, 0) != TRG_RET) | (hid_usage_to_trg(44, 0) != TRG_SPC) | (hid_usage_to_trg(42, 0) != TRG_BS) | (hid_usage_to_trg(82, 0) != TRG_ARROW_UP) | (hid_usage_to_trg(0, 0) != -1);
    if (trg_err != 0) [
        ret 8;
    ]
    xhci = arena@[ARENA_LENS_XHCI];
    if (xhci == 0) [
        ret 8;
    ]
    if ((xhci@[XHCI_ST_HID_COUNT] < 1) | (xhci@[XHCI_ST_MSI_MODE] == 0)) [
        ret 8;
    ]
    p_cnt = exocall!(arena, EXOCALL_INPUT_POLL, 0, 0, 0, 0);
    if (p_cnt < 0) [
        ret 8;
    ]
    ret 0;
]

fn test_console!(arena) [
    state_ptr = arena@[ARENA_LENS_CONSOLE];
    stride = state_ptr@[CONSOLE_LENS_STRIDE];
    backbuffer = state_ptr@[CONSOLE_LENS_BACKBUFFER];
    fb_base = state_ptr@[CONSOLE_LENS_FB_BASE];

    c_lo = COLOR_BG & 4294967295;
    bg_qw = (c_lo << 32) | c_lo;

    sample_a_idx = (5 * stride) >> 3;
    sample_a = backbuffer@[sample_a_idx];
    sample_b_idx = (21 * stride + 320) >> 3;
    sample_b = backbuffer@[sample_b_idx];

    render_err = (sample_a == bg_qw) | (sample_b == bg_qw);
    if (fb_base != 0) [
        render_err = render_err | (fb_base@[sample_a_idx] != sample_a) | (fb_base@[sample_b_idx] != sample_b);
    ]
    if (render_err != 0) [
        ret 9;
    ]
    ret 0;
]

fn test_dag_cycle!(arena) [
    svc_table = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (svc_table == 0) [
        ret 12;
    ]
    loop (cl:256 = 0 .. 256) [
        svc_table@[cl] = 0;
    ]
    idx_30_deps = (30 << 2) + SVC_LENS_DEPS;
    idx_31_deps = (31 << 2) + SVC_LENS_DEPS;
    svc_table@[idx_30_deps] = 1 << 31;
    svc_table@[idx_31_deps] = 1 << 30;

    cycle_res = dag_pick_next_runnable(svc_table, (1 << 30) | (1 << 31), 0);
    exocall!(arena, EXOCALL_PMM_FREE, svc_table, 1, 0, 0);
    if (cycle_res != -1) [
        ret 12;
    ]
    ret 0;
]

fn test_lit_slots!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];

    target_slot = slot_find_free(table);
    if (target_slot < 1) [
        ret 13;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_V1_SAFE_0, 0, ext_buf) != 0) [
        ret 14;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 14;
    ]
    pg_v1    = ext_buf@[CASE_EXT_PG];
    pages_v1 = ext_buf@[CASE_EXT_PAGES];
    bytes_v1 = ext_buf@[CASE_EXT_BYTES];
    hash_v1  = ext_buf@[CASE_EXT_HASH];
    lba_v1   = pg_v1 << 3;
    secs_v1  = pages_v1 << 3;

    if (case_find_artifact!(arena, FILE_V2_SAFE_0, 0, ext_buf) != 0) [
        ret 15;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 15;
    ]
    lba_v2  = ext_buf@[CASE_EXT_PG] << 3;
    secs_v2 = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_v2 = ext_buf@[CASE_EXT_HASH];

    if (case_find_artifact!(arena, FILE_SINC_SAFE_0, FILE_SINC_SAFE_1, ext_buf) != 0) [
        ret 16;
    ]

    r_load = exocall!(arena, EXOCALL_SLOT_LOAD, target_slot, lba_v1, secs_v1, hash_v1);
    if (r_load != LIT_EXIT_OK) [
        ret 17;
    ]

    if (slot_find_by_hash(table, hash_v1) != target_slot) [
        ret 18;
    ]

    val1 = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val1 != 100) [
        ret 19;
    ]

    r_swap = exocall!(arena, EXOCALL_SLOT_HOTSWAP, target_slot, lba_v2, secs_v2, hash_v2);
    if (r_swap != LIT_EXIT_OK) [
        ret 20;
    ]

    val2 = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val2 != 200) [
        ret 21;
    ]

    exocall!(arena, EXOCALL_SLOT_UNLOAD, target_slot, 0, 0, 0);
    if (slot_is_occupied(table, target_slot) != 0) [
        ret 22;
    ]

    mem_page = exocall!(arena, EXOCALL_PMM_ALLOC, pages_v1, 0, 0, 0);
    if (mem_page == 0) [
        ret 23;
    ]
    r_nvme = case_rw_pages!(arena, 0, pg_v1, pages_v1, mem_page);
    if (r_nvme != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, mem_page, pages_v1, 0, 0);
        ret 24;
    ]
    r_load_mem = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, target_slot, mem_page, bytes_v1, hash_v1);
    exocall!(arena, EXOCALL_PMM_FREE, mem_page, pages_v1, 0, 0);
    if (r_load_mem != LIT_EXIT_OK) [
        ret 25;
    ]
    val_mem = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val_mem != 100) [
        ret 26;
    ]
    exocall!(arena, EXOCALL_SLOT_UNLOAD, target_slot, 0, 0, 0);
    if (slot_is_occupied(table, target_slot) != 0) [
        ret 27;
    ]
    ret 0;
]

fn test_sinc_compiler!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];
    app_slot = slot_find_free(table);
    if (app_slot < 0) [
        ret 28;
    ]
    r_comp = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, app_slot);
    if (r_comp != 0) [
        ret 29;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, app_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, app_slot, 0, 0, 0);
    if (app_val != 77) [
        ret 30;
    ]
    ret 0;
]

fn test_coreutils!(arena) [
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_BUILD_SAFE_0, FILE_BUILD_SAFE_1, ext_buf) != 0) [
        ret 31;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 31;
    ]

    table = arena@[ARENA_LENS_LIT_TABLE];
    app_slot = slot_find_free(table);
    build_slot = slot_find_free_high(table);
    if ((app_slot < 1) | (!(app_slot < 10)) | (build_slot < 32)) [
        ret 32;
    ]

    lba = ext_buf@[CASE_EXT_PG] << 3;
    secs = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_val = ext_buf@[CASE_EXT_HASH];
    if (exocall!(arena, EXOCALL_SLOT_LOAD, build_slot, lba, secs, hash_val) != LIT_EXIT_OK) [
        ret 33;
    ]

    arg_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (arg_buf == 0) [
        exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
        ret 34;
    ]
    arg_buf@[0] = -1143866828831250150;
    arg_buf@[1] = 52 + app_slot;

    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    cli@[0] = arg_buf;
    cli@[1] = 9;

    b_res = exocall!(arena, EXOCALL_SLOT_CALL, build_slot, arena, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    exocall!(arena, EXOCALL_PMM_FREE, arg_buf, 1, 0, 0);

    if (b_res != 0) [
        ret 35;
    ]
    if (slot_is_occupied(table, app_slot) == 0) [
        ret 36;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, app_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, app_slot, 0, 0, 0);
    if (app_val != 77) [
        ret 37;
    ]
    ret 0;
]

fn battle_tamper_hash!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    table = arena@[ARENA_LENS_LIT_TABLE];
    t_slot = slot_find_free(table);
    if (t_slot < 1) [
        ret 101;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_V1_SAFE_0, 0, ext_buf) != 0) [
        ret 102;
    ]
    pg_v1    = ext_buf@[CASE_EXT_PG];
    pages_v1 = ext_buf@[CASE_EXT_PAGES];
    bytes_v1 = ext_buf@[CASE_EXT_BYTES];
    hash_v1  = ext_buf@[CASE_EXT_HASH];
    lba_v1   = pg_v1 << 3;
    secs_v1  = pages_v1 << 3;

    r_nvme = exocall!(arena, EXOCALL_SLOT_LOAD, t_slot, lba_v1, secs_v1, hash_v1 + 1);
    if ((r_nvme != LIT_ERR_BAD_HASH) | (slot_is_occupied(table, t_slot) != 0)) [
        ret 103;
    ]

    mem_buf = exocall!(arena, EXOCALL_PMM_ALLOC, pages_v1, 0, 0, 0);
    if (mem_buf == 0) [
        ret 104;
    ]
    if (case_rw_pages!(arena, 0, pg_v1, pages_v1, mem_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, mem_buf, pages_v1, 0, 0);
        ret 105;
    ]
    mem_buf@[4] = mem_buf@[4] + 1;
    r_mem = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, t_slot, mem_buf, bytes_v1, hash_v1);
    exocall!(arena, EXOCALL_PMM_FREE, mem_buf, pages_v1, 0, 0);
    if ((r_mem != LIT_ERR_BAD_HASH) | (slot_is_occupied(table, t_slot) != 0)) [
        ret 106;
    ]

    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if (p1 != p0) [
        ret 107;
    ]
    ret 0;
]

fn battle_cow_free_bufs!(arena, wbuf, rbuf, err) [
    if (wbuf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, wbuf, 3, 0, 0);
    ]
    if (rbuf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, rbuf, 3, 0, 0);
    ]
    ret err;
]

fn battle_cow_adversarial!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    wbuf = exocall!(arena, EXOCALL_PMM_ALLOC, 3, 0, 0, 0);
    rbuf = exocall!(arena, EXOCALL_PMM_ALLOC, 3, 0, 0, 0);
    if ((wbuf == 0) | (rbuf == 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 110);
    ]
    loop (z:1536 = 0 .. 1536) [
        wbuf@[z] = 0;
        rbuf@[z] = 0;
    ]
    wbuf@[0]    = 111111;
    wbuf@[600]  = 222222;
    wbuf@[1200] = 333333;

    if (case_write_file!(arena, CASE_TYPE_DATA, 891298331, 0, wbuf, 10000) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 111);
    ]
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, 891298331, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 112);
    ]
    pg_big    = ext_buf@[CASE_EXT_PG];
    pages_big = ext_buf@[CASE_EXT_PAGES];
    if ((pages_big != 3) | (case_rw_pages!(arena, 0, pg_big, 3, rbuf) != 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 113);
    ]
    if ((rbuf@[0] != 111111) | (rbuf@[600] != 222222) | (rbuf@[1200] != 333333)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 114);
    ]

    wbuf@[0] = 444444;
    if (case_write_file!(arena, CASE_TYPE_DATA, 841425453, 0, wbuf, 64) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 115);
    ]
    if (case_find_artifact!(arena, 841425453, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 116);
    ]
    pg_tiny1 = ext_buf@[CASE_EXT_PG];
    hs_tiny1 = ext_buf@[CASE_EXT_HASH];
    if (case_entry_epoch(ext_buf@[CASE_EXT_META]) != 1) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 117);
    ]

    w_oom = case_write_file!(arena, CASE_TYPE_DATA, 841425453, 0, wbuf, 4194304);
    if (!(w_oom < 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 118);
    ]

    if (case_find_artifact!(arena, 841425453, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 119);
    ]
    if ((ext_buf@[CASE_EXT_PG] != pg_tiny1) | (ext_buf@[CASE_EXT_HASH] != hs_tiny1) | (case_entry_epoch(ext_buf@[CASE_EXT_META]) != 1)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 120);
    ]
    rbuf@[0] = 0;
    if ((case_rw_pages!(arena, 0, pg_tiny1, 1, rbuf) != 0) | (rbuf@[0] != 444444)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 121);
    ]

    if (case_delete_file!(arena, 891298331, 0) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 122);
    ]
    wbuf@[0]   = 555555;
    wbuf@[600] = 666666;
    if (case_write_file!(arena, CASE_TYPE_DATA, 908603437, 0, wbuf, 6000) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 123);
    ]
    if (case_find_artifact!(arena, 908603437, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 124);
    ]
    pg_two2 = ext_buf@[CASE_EXT_PG];
    if ((pg_two2 != pg_big) | (ext_buf@[CASE_EXT_PAGES] != 2)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 125);
    ]
    rbuf@[0]   = 0;
    rbuf@[600] = 0;
    if ((case_rw_pages!(arena, 0, pg_two2, 2, rbuf) != 0) | (rbuf@[0] != 555555) | (rbuf@[600] != 666666)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 126);
    ]

    d_tiny = case_delete_file!(arena, 841425453, 0);
    d_two2 = case_delete_file!(arena, 908603437, 0);
    battle_cow_free_bufs!(arena, wbuf, rbuf, 0);
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if ((d_tiny != 0) | (d_two2 != 0) | (p1 != p0)) [
        ret 127;
    ]
    ret 0;
]

fn battle_type_slot_guards!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];
    s_free = slot_find_free(table);
    if (s_free < 1) [
        ret 130;
    ]

    r_type = cell_compile_and_load!(arena, FILE_V1_SAFE_0, 0, s_free);
    if ((r_type != 14) | (slot_is_occupied(table, s_free) != 0)) [
        ret 131;
    ]

    if (slot_is_occupied(table, 1) == 0) [
        ret 132;
    ]
    r_occ = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, 1);
    if (r_occ != 17) [
        ret 133;
    ]

    r_oob = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, 64);
    if (r_oob != 16) [
        ret 134;
    ]
    ret 0;
]

fn battle_cell_abort_unwind!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    table = arena@[ARENA_LENS_LIT_TABLE];
    s_free = slot_find_free(table);
    if ((s_free < 1) | (!(s_free < 10))) [
        ret 140;
    ]

    r_bad1 = cell_compile_and_load!(arena, 2317996998753327643, 0, s_free);
    if ((r_bad1 != 20) | (slot_is_occupied(table, s_free) != 0)) [
        ret 141;
    ]

    r_bad2 = cell_compile_and_load!(arena, 2317996998770104859, 0, s_free);
    if ((r_bad2 != 8) | (slot_is_occupied(table, s_free) != 0)) [
        ret 142;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_BUILD_SAFE_0, FILE_BUILD_SAFE_1, ext_buf) != 0) [
        ret 143;
    ]
    build_slot = slot_find_free_high(table);
    if (build_slot < 32) [
        ret 144;
    ]
    if (exocall!(arena, EXOCALL_SLOT_LOAD, build_slot, ext_buf@[CASE_EXT_PG] << 3, ext_buf@[CASE_EXT_PAGES] << 3, ext_buf@[CASE_EXT_HASH]) != LIT_EXIT_OK) [
        ret 145;
    ]
    arg_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (arg_buf == 0) [
        exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
        ret 146;
    ]
    arg_buf@[0] = -1143866828831250150;
    arg_buf@[1] = 52 + s_free;

    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    cli@[0] = arg_buf;
    cli@[1] = 9;

    b_res = exocall!(arena, EXOCALL_SLOT_CALL, build_slot, arena, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    exocall!(arena, EXOCALL_PMM_FREE, arg_buf, 1, 0, 0);

    if ((b_res != 0) | (slot_is_occupied(table, s_free) == 0)) [
        ret 147;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, s_free, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, s_free, 0, 0, 0);
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if ((app_val != 77) | (p1 != p0)) [
        ret 148;
    ]
    ret 0;
]

fn test_case_128!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);

    bmp_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    rd_buf  = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((bmp_buf == 0) | (rd_buf == 0)) [
        if (bmp_buf != 0) [ exocall!(arena, EXOCALL_PMM_FREE, bmp_buf, 1, 0, 0); ]
        if (rd_buf != 0) [ exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0); ]
        ret 21;
    ]
    if (exocall!(arena, EXOCALL_NVME_RW, 0, CASE_BITMAP_LBA, 8, bmp_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, bmp_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
        ret 21;
    ]
    // Verify pages 0..24 (specifically Pg 19) remain locked in CASE bitmap
    if (((bmp_buf@[0] & CASE_RESERVED_MASK) != CASE_RESERVED_MASK) | (!(case_mark_pages!(bmp_buf, 19, 1, 0) < 0))) [
        exocall!(arena, EXOCALL_PMM_FREE, bmp_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
        ret 22;
    ]
    alloc_pg = case_alloc_pages!(bmp_buf, 512, 1);
    exocall!(arena, EXOCALL_PMM_FREE, bmp_buf, 1, 0, 0);
    if (alloc_pg < CASE_DATA_START_PG) [
        exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
        ret 22;
    ]

    // Lookup hi70.dat seeded at entry index 70 (Page 19)
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, 3249943054441456161, 0, ext_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
        ret 23;
    ]
    if (case_rw_pages!(arena, 0, ext_buf@[CASE_EXT_PG], 1, rd_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
        ret 23;
    ]
    h_ok = (case_fnv1a_64(rd_buf, ext_buf@[CASE_EXT_BYTES]) == ext_buf@[CASE_EXT_HASH]);
    exocall!(arena, EXOCALL_PMM_FREE, rd_buf, 1, 0, 0);
    if (h_ok == 0) [
        ret 24;
    ]

    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if (p1 != p0) [ ret 25; ]
    ret 0;
]

fn test_run_pkg!(arena, pkg_slot, cmd_buf, cmd_len) [
    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    cli@[0] = cmd_buf;
    cli@[1] = cmd_len;
    r = exocall!(arena, EXOCALL_SLOT_CALL, pkg_slot, arena, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    ret r;
]

fn test_pkg!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);

    data_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    cmd_buf  = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((data_buf == 0) | (cmd_buf == 0)) [
        if (data_buf != 0) [ exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0); ]
        if (cmd_buf != 0) [ exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0); ]
        ret 26;
    ]
    loop (z:512 = 0 .. 512) [
        data_buf@[z] = 0;
        cmd_buf@[z]  = 0;
    ]
    data_buf@[0] = 123456789;
    data_buf@[1] = 987654321;

    n_a0 = 1881938511500682281; // "pkg_a.dat"
    n_b0 = 1881938515795649577; // "pkg_b.dat"
    if ((case_write_file!(arena, CASE_TYPE_DATA, n_a0, 45, data_buf, 64) != 0) | (case_write_file!(arena, CASE_TYPE_DATA, n_b0, 45, data_buf, 64) != 0)) [
        exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0);
        ret 27;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_PKG_SAFE_0, 0, ext_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0);
        ret 28;
    ]
    table = arena@[ARENA_LENS_LIT_TABLE];
    pkg_slot = slot_find_free_high(table);
    if (pkg_slot < 1) [
        exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0);
        ret 28;
    ]
    if (exocall!(arena, EXOCALL_SLOT_LOAD, pkg_slot, ext_buf@[CASE_EXT_PG] << 3, ext_buf@[CASE_EXT_PAGES] << 3, ext_buf@[CASE_EXT_HASH]) != LIT_EXIT_OK) [
        exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0);
        ret 28;
    ]

    err = 0;
    // 1. install pkg_a.dat 1 0 -> 0, verify -> 0
    cmd_buf@[0] = -1142466136111306974; cmd_buf@[1] = n_a0; cmd_buf@[2] = 227368366125;
    if (test_run_pkg!(arena, pkg_slot, cmd_buf, 21) != 0) [ err = 29; ]
    cmd_buf@[0] = 55109298626095; // "verify"
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 6) != 0)) [ err = 29; ]

    // 2. install pkg_b.dat 1 1 (dep on id 0) -> 0
    cmd_buf@[0] = -1142466136111306974; cmd_buf@[1] = n_b0; cmd_buf@[2] = 231663333421;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 21) != 0)) [ err = 30; ]

    // 3. remove pkg_a.dat must fail while pkg_b.dat depends on it
    cmd_buf@[0] = 3021948537851485739; cmd_buf@[1] = 3249943054017306660;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 16) == 0)) [ err = 31; ]

    // 4. upgrade pkg_a.dat 2 0 -> 0; downgrade pkg_a.dat 1 0 -> != 0; verify -> 0
    cmd_buf@[0] = -1144445257075644114; cmd_buf@[1] = n_a0; cmd_buf@[2] = 227368431661;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 21) != 0)) [ err = 32; ]
    cmd_buf@[0] = -1144445257075644114; cmd_buf@[1] = n_a0; cmd_buf@[2] = 227368366125;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 21) == 0)) [ err = 33; ]
    cmd_buf@[0] = 55109298626095;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 6) != 0)) [ err = 34; ]

    // 5. Live 1-byte NVMe tamper detection: mutate pkg_a.dat on disk -> verify must fail
    if (err == 0) [
        if (case_find_artifact!(arena, n_a0, 45, ext_buf) != 0) [
            err = 35;
        ] else [
            pg_a = ext_buf@[CASE_EXT_PG];
            if (case_rw_pages!(arena, 0, pg_a, 1, data_buf) != 0) [
                err = 35;
            ] else [
                data_buf@[0] = data_buf@[0] ^ 1;
                if (case_rw_pages!(arena, 1, pg_a, 1, data_buf) != 0) [
                    err = 35;
                ] else [
                    cmd_buf@[0] = 55109298626095;
                    if (test_run_pkg!(arena, pkg_slot, cmd_buf, 6) == 0) [
                        err = 36;
                    ]
                ]
            ]
        ]
    ]

    // 6. Clean remove pkg_b.dat -> remove pkg_a.dat -> delete pkg.db -> zero leaks
    cmd_buf@[0] = 3021948537851485739; cmd_buf@[1] = 3249943054034083876;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 16) != 0)) [ err = 37; ]
    cmd_buf@[0] = 3021948537851485739; cmd_buf@[1] = 3249943054017306660;
    if ((err == 0) & (test_run_pkg!(arena, pkg_slot, cmd_buf, 16) != 0)) [ err = 37; ]
    if (err == 0) [
        if (case_delete_file!(arena, FILE_PKG_DB_0, 0) != 0) [ err = 37; ]
    ]

    exocall!(arena, EXOCALL_SLOT_UNLOAD, pkg_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, data_buf, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, cmd_buf, 1, 0, 0);
    if (err != 0) [ ret err; ]

    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if (p1 != p0) [ ret 38; ]
    ret 0;
]

fn test_display_abi!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);

    ctrl = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    ring = exocall!(arena, EXOCALL_PMM_ALLOC, SAGR_CMD_RING_PAGES, 0, 0, 0);
    if ((ctrl == 0) | (ring == 0)) [
        if (ctrl != 0) [ exocall!(arena, EXOCALL_PMM_FREE, ctrl, 1, 0, 0); ]
        if (ring != 0) [ exocall!(arena, EXOCALL_PMM_FREE, ring, SAGR_CMD_RING_PAGES, 0, 0); ]
        ret 39;
    ]
    sagr_ring_init!(ctrl, ring);
    if ((ctrl@[DISP_LENS_FORMAT] != SURF_FMT_BGRA8) | (ctrl@[DISP_LENS_CMD_RING] != ring)) [
        exocall!(arena, EXOCALL_PMM_FREE, ctrl, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, ring, SAGR_CMD_RING_PAGES, 0, 0);
        ret 40;
    ]

    err = 0;
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, 1, 10, 20), sagr_pack_ext(100, 50, 16777215), 4, 0) != 0) [ err = 40; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_BLIT_SURFACE, 0, 5, 6), sagr_pack_ext(32, 16, 128), 4096, 64) != 0) [ err = 40; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_GLYPH_RUN, SAGR_FLAG_OPAQUE_BG | SAGR_FLAG_CLIP, 8, 16), sagr_pack_ext(12, 2, 6401007), 8192, sagr_pack_clip(0, 0, 640, 480)) != 0) [ err = 40; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_DAMAGE_RECT, 3, 10, 20), sagr_pack_ext(100, 50, 0), 0, 0) != 0) [ err = 40; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_COMMIT, 3, 1, 0), 0, 42, 0) != 0) [ err = 40; ]

    out_cmd = arena@[ARENA_LENS_META_BUF] + 640;
    loop (c:5 = 1 .. 6) [
        if ((err == 0) & (sagr_ring_pop!(ctrl, out_cmd) != 0)) [ err = 41; ]
        if ((err == 0) & (sagr_cmd_op(out_cmd@[0]) != c)) [ err = 41; ]
        if ((err == 0) & (c == SAGR_CMD_GLYPH_RUN)) [
            if ((sagr_cmd_flags(out_cmd@[0]) != (SAGR_FLAG_OPAQUE_BG | SAGR_FLAG_CLIP)) | (sagr_cmd_u32(out_cmd@[1]) != 6401007) | (out_cmd@[2] != 8192)) [ err = 41; ]
        ]
        if ((err == 0) & (c == SAGR_CMD_COMMIT)) [
            if ((sagr_cmd_flags(out_cmd@[0]) != 3) | (out_cmd@[2] != 42)) [ err = 41; ]
            ctrl@[DISP_LENS_FRAME_SEQ] = out_cmd@[2];
        ]
    ]
    if ((err == 0) & ((!(sagr_ring_pop!(ctrl, out_cmd) < 0)) | (ctrl@[DISP_LENS_FRAME_SEQ] != 42) | (ctrl@[DISP_LENS_CMD_SEQ] != 42))) [
        err = 41;
    ]

    // Wrap & full-ring saturation across exact 256-slot (8192 B) boundary
    if (err == 0) [
        loop (f:255 = 0 .. 255) [
            if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, 0, f, f), 0, 0, 0) != 0) [ err = 42; ]
        ]
        if ((!(sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, 0, 0, 0), 0, 0, 0) < 0)) | (ctrl@[DISP_LENS_CMD_DROPPED] != 1)) [ err = 42; ]
    ]

    exocall!(arena, EXOCALL_PMM_FREE, ctrl, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, ring, SAGR_CMD_RING_PAGES, 0, 0);
    if (err != 0) [ ret err; ]

    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if (p1 != p0) [ ret 42; ]
    ret 0;
]

fn test_gui_phase1!(arena) [
    disp_ctrl = arena@[ARENA_LENS_DISPLAY];
    con       = arena@[ARENA_LENS_CONSOLE];
    bi        = arena@[ARENA_LENS_BOOT_INFO];
    if ((disp_ctrl == 0) | (con == 0) | (bi == 0)) [
        ret 43;
    ]

    fb_base = bi@[BOOT_LENS_FB_BASE];
    width   = con@[CONSOLE_LENS_WIDTH];
    height  = con@[CONSOLE_LENS_HEIGHT];
    stride  = con@[CONSOLE_LENS_STRIDE];
    if ((disp_ctrl@[DISP_LENS_FRONT_FB] != fb_base) | (con@[CONSOLE_LENS_FB_BASE] != fb_base)) [
        ret 43;
    ]
    if ((disp_ctrl@[DISP_LENS_BACK_FB] == 0) | (disp_ctrl@[DISP_LENS_BACK_FB] != con@[CONSOLE_LENS_BACKBUFFER])) [
        ret 43;
    ]
    if ((disp_ctrl@[DISP_LENS_WIDTH] != width) | (disp_ctrl@[DISP_LENS_HEIGHT] != height) | (disp_ctrl@[DISP_LENS_STRIDE] != stride)) [
        ret 43;
    ]
    if ((stride < (width << 2)) | ((stride & 3) != 0)) [
        ret 43;
    ]
    if ((disp_ctrl@[DISP_LENS_FORMAT] != SURF_FMT_BGRA8) | (disp_ctrl@[DISP_LENS_CMD_RING] == 0)) [
        ret 43;
    ]

    // Verify 2 MB PDEs overlapping fb_base were split and 4 KB PTEs carry PAT4 = WC (PAT=1, PCD=0, PWT=0)
    cr3_base = arena@[ARENA_LENS_CR3] & 4503599627366400;
    loop (pg:2 = 0 .. 2) [
        va        = fb_base + (pg << 12);
        pml4_idx  = (va >> 39) & 511;
        pdpt_base = cr3_base@[pml4_idx] & 4503599627366400;
        pdpt_idx   = (va >> 30) & 511;
        pdpt_entry = pdpt_base@[pdpt_idx];
        if ((pdpt_entry & 128) != 0) [
            ret 44;
        ]
        pd_base    = pdpt_entry & 4503599627366400;
        pd_idx    = (va >> 21) & 511;
        pd_entry  = pd_base@[pd_idx];
        if ((pd_entry & 128) != 0) [
            ret 44;
        ]
        pt_base = pd_entry & 4503599627366400;
        pt_idx  = (va >> 12) & 511;
        pte     = pt_base@[pt_idx];
        if ((pte & 152) != 128) [
            ret 44;
        ]
    ]

    // Verify CONSOLE_LENS_STREAM_BUF captures pure TRG console output with 0 PMM leaks
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (p0 == 0) [
        ret 45;
    ]
    buf = p0 + 24;
    p0@[0] = 0;
    p0@[1] = 2048;
    p0@[2] = buf;
    con@[CONSOLE_LENS_STREAM_BUF] = p0;
    console_print_dec!(con, 42);
    console_newline!(con);
    cap_len = p0@[0];
    b0 = buf@[0 * 1];
    b1 = buf@[1 * 1];
    b2 = buf@[2 * 1];
    console_clear!(con);
    clr_len = p0@[0];
    con@[CONSOLE_LENS_STREAM_BUF] = 0;
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);

    if ((cap_len != 3) | (b0 != 56) | (b1 != 54) | (b2 != 241) | (clr_len != 0) | (p1 != p0)) [
        ret 45;
    ]
    ret 0;
]

fn test_sagr_raster!(arena) [
    bi = arena@[ARENA_LENS_BOOT_INFO];
    pmm = arena@[ARENA_LENS_PMM];
    font_ptr = bi@[BOOT_LENS_FONT_BASE];
    if ((font_ptr == 0) | (pmm == 0)) [ ret 46; ]
    free0 = pmm@[PMM_LENS_FREE_PAGES];

    // Allocate synthetic 69x20 surface (stride=304 > 69*4=276; odd width + clipped right/bottom tiles)
    ctrl      = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    ring      = exocall!(arena, EXOCALL_PMM_ALLOC, SAGR_CMD_RING_PAGES, 0, 0, 0);
    tile_mask = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    front_fb  = exocall!(arena, EXOCALL_PMM_ALLOC, 2, 0, 0, 0);
    back_fb   = exocall!(arena, EXOCALL_PMM_ALLOC, 2, 0, 0, 0);
    scratch   = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((ctrl == 0) | (ring == 0) | (tile_mask == 0) | (front_fb == 0) | (back_fb == 0) | (scratch == 0)) [
        ret 46;
    ]

    sentinel = 1234605616436508552; // 0x1122334455667788
    loop (i:1024 = 0 .. 1024) [
        front_fb@[i] = sentinel;
        back_fb@[i]  = sentinel;
    ]
    tile_clear_all!(tile_mask);

    sagr_ring_init!(ctrl, ring);
    ctrl@[DISP_LENS_FRONT_FB] = front_fb;
    ctrl@[DISP_LENS_BACK_FB]  = back_fb;
    ctrl@[DISP_LENS_WIDTH]    = 69;
    ctrl@[DISP_LENS_HEIGHT]   = 20;
    ctrl@[DISP_LENS_STRIDE]   = 304;

    out_cmd = scratch;
    str_buf = scratch + 64;
    str_buf@[0] = 0; // 'A' (TRG 0)
    src_surf = scratch + 128;
    src_col = 11259375; // 0x00ABCDEF
    src_surf@[0] = (src_col << 32) | src_col;
    src_surf@[1] = (src_col << 32) | src_col;

    err = 0;
    // Batch 1: 150 DAMAGE_RECT commands -> drained incrementally before Batch 2
    loop (b1:150 = 0 .. 150) [
        if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_DAMAGE_RECT, 0, 0, 0), sagr_pack_ext(16, 16, 0), 0, 0) != 0) [
            err = 46;
        ]
    ]
    d1 = sagr_drain_ring!(ctrl, font_ptr, tile_mask, out_cmd);
    if (d1 != 150) [ err = 46; ]

    // Batch 2 (> 256 cumulative across ring wrap): fill 69x20, bordered rect, negative-x clip, blit, glyph, damage, commit
    loop (b2:150 = 0 .. 150) [
        if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_DAMAGE_RECT, 0, 64, 16), sagr_pack_ext(5, 4, 0), 0, 0) != 0) [
            err = 47;
        ]
    ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, 0, 0, 0), sagr_pack_ext(69, 20, 1122867), 0, 0) != 0) [ err = 47; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, SAGR_FLAG_BORDER, 2, 2), sagr_pack_ext(10, 6, 2236962), 16777215 | (1 << 32), 0) != 0) [ err = 47; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_RECT, 0, -2, -1), sagr_pack_ext(6, 4, 4478310), 0, 0) != 0) [ err = 47; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_BLIT_SURFACE, 0, 67, 18), sagr_pack_ext(2, 2, 8), src_surf, 0) != 0) [ err = 47; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_GLYPH_RUN, SAGR_FLAG_OPAQUE_BG, 16, 0), sagr_pack_ext(1, 1, 16777215), str_buf, 1122867) != 0) [ err = 47; ]
    if (sagr_ring_push!(ctrl, sagr_pack_hdr(SAGR_CMD_COMMIT, 0, 0, 0), 0, 99, 0) != 0) [ err = 47; ]

    d2 = sagr_drain_ring!(ctrl, font_ptr, tile_mask, out_cmd);
    if ((d2 != 156) | (ctrl@[DISP_LENS_CMD_DROPPED] != 0) | (ctrl@[DISP_LENS_FRAME_SEQ] != 99)) [
        err = 48;
    ]

    // Verify front_fb interior, odd right edge (x=68), bottom-right blit (68, 19), glyph 'A', and untouched stride/height sentinels
    px_0_0   = front_fb@[0] & 4294967295;               // 0x00445566 (4478310) from clipped (-2,-1,6,4)
    px_4_2   = front_fb@[((2 * 304 + 16) >> 3)] & 4294967295; // border 16777215 at x=4, y=2 (outside clipped Rec 3)
    px_68_0  = front_fb@[((0 * 304 + 68 * 4) >> 3)] & 4294967295; // odd right pixel x=68: 1122867
    pad_0    = front_fb@[((0 * 304 + 276) >> 3)];        // first u64 padding after 69 px: top 32 bits must remain 0x11223344
    px_68_19 = front_fb@[((19 * 304 + 68 * 4) >> 3)] & 4294967295; // blit at (67..68, 18..19): src_col (11259375)
    row20    = front_fb@[((20 * 304) >> 3)];             // below height=20 must stay sentinel
    if (px_0_0 != 4478310) [ err = 51; ]
    if (px_4_2 != 16777215) [ err = 52; ]
    if (px_68_0 != 1122867) [ err = 53; ]
    if (px_68_19 != src_col) [ err = 54; ]
    if (row20 != sentinel) [ err = 55; ]
    if (((pad_0 >> 32) & 4294967295) != ((sentinel >> 32) & 4294967295)) [ err = 56; ]
    // Verify 'A' glyph foreground pixel rendered cleanly at (16..23, 0..15) onto front_fb
    has_fg = 0;
    loop (gy:16 = 0 .. 16) [
        q = front_fb@[((gy * 304 + 16 * 4) >> 3)];
        p0 = q & 4294967295;
        p1 = (q >> 32) & 4294967295;
        if ((p0 == 16777215) | (p1 == 16777215)) [ has_fg = 1; ]
    ]
    if ((has_fg == 0) | (tile_is_dirty(tile_mask, 0) != 0) | (tile_is_dirty(tile_mask, 9) != 0)) [
        err = 50;
    ]

    exocall!(arena, EXOCALL_PMM_FREE, ctrl, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, ring, SAGR_CMD_RING_PAGES, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, tile_mask, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, front_fb, 2, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, back_fb, 2, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, scratch, 1, 0, 0);
    if (err != 0) [ ret err; ]

    if (pmm@[PMM_LENS_FREE_PAGES] != free0) [ ret 50; ]
    ret 0;
]

fn test_niri_layout!(arena) [
    pmm = arena@[ARENA_LENS_PMM];
    if (pmm == 0) [ ret 57; ]
    free0 = pmm@[PMM_LENS_FREE_PAGES];

    wm       = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    cols_ptr = exocall!(arena, EXOCALL_PMM_ALLOC, 2, 0, 0, 0);
    xywh     = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((wm == 0) | (cols_ptr == 0) | (xywh == 0)) [ ret 57; ]

    loop (i:512 = 0 .. 512) [ wm@[i] = 0; xywh@[i] = 0; ]
    loop (j:1024 = 0 .. 1024) [ cols_ptr@[j] = 0; ]

    sw = 1280;
    sh = 800;
    err = 0;

    // 1. Insert 4 columns of width_mode=1 (1/2 screen = 628 px -> 4 cols push target_scroll_x > 1280)
    if (niri_insert_col!(wm, cols_ptr, 0, -1, 10, 1, sw) != 0) [ err = 57; ]
    if (niri_insert_col!(wm, cols_ptr, 0, 0,  11, 1, sw) != 1) [ err = 57; ]
    if (niri_insert_col!(wm, cols_ptr, 0, 1,  12, 1, sw) != 2) [ err = 57; ]
    if (niri_insert_col!(wm, cols_ptr, 0, 2,  13, 1, sw) != 3) [ err = 57; ]

    wbase = niri_ws_off(0);
    tgt = wm@[(wbase + WS_LENS_TARGET_X)];
    if ((wm@[(wbase + WS_LENS_COL_CNT)] != 4) | (wm@[(wbase + WS_LENS_FOCUS_C)] != 3) | (!(tgt > 0))) [
        err = 58;
    ]

    // 2. Step TSC camera easing until settled -> verify exact snap and 0 on settled tick
    steps = 0;
    loop (s:32 = 0 .. 32) [
        if (niri_step_camera!(wm, 0) != 0) [
            steps = steps + 1;
        ]
    ]
    scroll_x = wm@[(wbase + WS_LENS_SCROLL_X)];
    if ((steps < 2) | (scroll_x != tgt) | (niri_step_camera!(wm, 0) != 0)) [
        err = 58;
    ]

    // Verify off-screen culling: col 0 must be culled when viewing col 3, col 3 visible
    c0x = cols_ptr@[(niri_col_off(0, 0) + COL_LENS_X)];
    c0w = cols_ptr@[(niri_col_off(0, 0) + COL_LENS_W)];
    c3x = cols_ptr@[(niri_col_off(0, 3) + COL_LENS_X)];
    c3w = cols_ptr@[(niri_col_off(0, 3) + COL_LENS_W)];
    if ((niri_is_col_visible(c0x, c0w, scroll_x, sw) != 0) | (niri_is_col_visible(c3x, c3w, scroll_x, sw) == 0)) [
        err = 59;
    ]

    // 3. Consume right, check stacked rect math, expel, move, remove all cleanly
    niri_focus_col!(wm, cols_ptr, 0, -1, sw); // focus col 2
    if (niri_consume_right!(wm, cols_ptr, 0, sw) != 1) [ err = 60; ]
    coff2 = niri_col_off(0, 2);
    if ((wm@[(wbase + WS_LENS_COL_CNT)] != 3) | (cols_ptr@[(coff2 + COL_LENS_PANE_CNT)] != 2)) [
        err = 60;
    ]
    niri_pane_rect!(cols_ptr, 0, 2, 0, wm@[(wbase + WS_LENS_SCROLL_X)], sh, xywh);
    y0 = xywh@[1]; h0 = xywh@[3];
    niri_pane_rect!(cols_ptr, 0, 2, 1, wm@[(wbase + WS_LENS_SCROLL_X)], sh, xywh);
    y1 = xywh@[1]; h1 = xywh@[3];
    if ((y1 != (y0 + h0 + SAGR_GAP)) | ((y1 + h1) != (sh - SAGR_GAP))) [
        err = 60;
    ]

    // Expel back to 4 columns & remove all cleanly
    if (niri_expel_focused!(wm, cols_ptr, 0, sw) != 1) [ err = 61; ]
    if (niri_move_col!(wm, cols_ptr, 0, -1, sw) != 1) [ err = 61; ]
    loop (rm:4 = 0 .. 4) [
        niri_remove_pane!(wm, cols_ptr, 0, 0, 0, sw);
    ]
    if (wm@[(wbase + WS_LENS_COL_CNT)] != 0) [ err = 61; ]

    exocall!(arena, EXOCALL_PMM_FREE, wm, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, cols_ptr, 2, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, xywh, 1, 0, 0);
    if (err != 0) [ ret err; ]
    if (pmm@[PMM_LENS_FREE_PAGES] != free0) [ ret 62; ]
    ret 0;
]

fn test_bootinfo!(arena) [
    bi = arena@[ARENA_LENS_BOOT_INFO];
    if (bi == 0) [
        ret 20;
    ]
    if (bi@[BOOT_LENS_MAGIC_VER] != BOOT_INFO_MAGIC_VER) [
        ret 20;
    ]
    if ((bi@[BOOT_LENS_FB_BASE] == 0) | (bi@[BOOT_LENS_RAM_TAPE] == 0) | (bi@[BOOT_LENS_REGION_COUNT] < 1) | (bi@[BOOT_LENS_STORAGE_BAR] == 0)) [
        ret 20;
    ]
    if (bi@[BOOT_LENS_XHCI_BAR] == 0) [
        ret 20;
    ]
    if (bi@[BOOT_LENS_TSC_KHZ] < 10000) [
        ret 20;
    ]
    s_sz = bi@[BOOT_LENS_SHARK_SIZE];
    f_base = bi@[BOOT_LENS_FONT_BASE];
    f_sz = bi@[BOOT_LENS_FONT_SIZE];
    f_hash = bi@[BOOT_LENS_FONT_HASH];
    if ((bi@[BOOT_LENS_SHARK_BASE] == 0) | (!(s_sz > SHARK_BIN_CODE_OFF)) | (f_base == 0) | (f_sz != 4096)) [
        ret 20;
    ]
    if (case_fnv1a_64(f_base, f_sz) != f_hash) [
        ret 20;
    ]
    ret 0;
]

fn main!(arena) [
    if (arena == 0) [
        ret 11;
    ]

    if (test_bootinfo!(arena) != 0) [
        ret 20;
    ]

    if (test_pmm!(arena) != 0) [
        ret 1;
    ]
    if (test_caps!(arena) != 0) [
        ret 3;
    ]
    if (test_nvme_case!(arena) != 0) [
        ret 6;
    ]
    if (test_ring!(arena) != 0) [
        ret 7;
    ]
    if (test_xhci_hid!(arena) != 0) [
        ret 8;
    ]
    if (test_console!(arena) != 0) [
        ret 9;
    ]

    t_res = exocall!(arena, EXOCALL_SLEEP_US, 5000, 0, 0, 0);
    timer_ptr = arena@[ARENA_LENS_TIMER];
    if ((t_res == 0) | (timer_ptr@[0] < 1)) [
        ret 10;
    ]

    if (test_dag_cycle!(arena) != 0) [
        ret 12;
    ]
    if (test_lit_slots!(arena) != 0) [
        ret 13;
    ]
    if (test_sinc_compiler!(arena) != 0) [
        ret 14;
    ]
    if (test_coreutils!(arena) != 0) [
        ret 15;
    ]
    if (battle_tamper_hash!(arena) != 0) [
        ret 16;
    ]
    if (battle_cow_adversarial!(arena) != 0) [
        ret 17;
    ]
    if (battle_type_slot_guards!(arena) != 0) [
        ret 18;
    ]
    if (battle_cell_abort_unwind!(arena) != 0) [
        ret 19;
    ]
    if (test_case_128!(arena) != 0) [
        ret 21;
    ]
    if (test_pkg!(arena) != 0) [
        ret 26;
    ]
    if (test_display_abi!(arena) != 0) [
        ret 39;
    ]
    if (test_gui_phase1!(arena) != 0) [
        ret 43;
    ]
    r_sagr = test_sagr_raster!(arena);
    if (r_sagr != 0) [
        ret r_sagr;
    ]
    r_niri = test_niri_layout!(arena);
    if (r_niri != 0) [
        ret r_niri;
    ]

    ret 0;
]

