// ==========================================
// selftest/sys/entry.sinc
// Sovereign Hardware Invariant Proof Cell (Strict Law 15)
// ==========================================

fn test_pmm!(arena) [
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    p2 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if ((p1 == 0) | (p2 == 0) | (p1 == p2)) [
        ret 1;
    ]
    f_res = exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    p3 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p2, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p3, 1, 0, 0);
    if ((f_res != 0) | (p3 != p1)) [
        ret 2;
    ]
    ret 0;
]

fn test_caps!(arena) [
    cap_table = arena@[ARENA_LENS_CAP_TABLE];
    live_mask_ptr = arena@[ARENA_LENS_LIVE_MASK];

    sip_id = cap_sip_alloc!(live_mask_ptr);
    if (sip_id != 0) [
        ret 3;
    ]
    token = cap_mint!(cap_table, 0, sip_id);
    live_mask = live_mask_ptr@[0];
    v1 = cap_validate_token(token, cap_table, live_mask);
    if (v1 != 1) [
        ret 4;
    ]
    cap_revoke!(cap_table, 0);
    v2 = cap_validate_token(token, cap_table, live_mask);
    if (v2 != 0) [
        ret 5;
    ]
    cap_sip_free!(live_mask_ptr, sip_id);
    ret 0;
]

fn test_nvme_case!(arena) [
    write_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    read_buf  = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    loop (z:512 = 0 .. 512) [
        write_buf@[z] = 0;
        read_buf@[z] = 0;
    ]
    write_buf@[0] = -77074246535541692;
    write_buf@[1] = 1337;

    tmp_n0 = 1397296901;
    h1 = case_fnv1a_64(write_buf, 64);
    w1 = case_write_file!(arena, CASE_TYPE_DATA, tmp_n0, 0, write_buf, 64);
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    f1 = case_find_artifact!(arena, tmp_n0, 0, ext_buf);
    pg1 = ext_buf@[CASE_EXT_PG];
    ep1 = case_entry_epoch(ext_buf@[CASE_EXT_META]);
    ty1 = case_entry_type(ext_buf@[CASE_EXT_META]);
    hs1 = ext_buf@[CASE_EXT_HASH];
    r1 = case_rw_pages!(arena, 0, pg1, 1, read_buf);
    m1 = read_buf@[0];
    t1 = read_buf@[1];

    write_buf@[1] = 7331;
    h2 = case_fnv1a_64(write_buf, 64);
    w2 = case_write_file!(arena, CASE_TYPE_DATA, tmp_n0, 0, write_buf, 64);
    f2 = case_find_artifact!(arena, tmp_n0, 0, ext_buf);
    pg2 = ext_buf@[CASE_EXT_PG];
    ep2 = case_entry_epoch(ext_buf@[CASE_EXT_META]);
    hs2 = ext_buf@[CASE_EXT_HASH];
    r2 = case_rw_pages!(arena, 0, pg2, 1, read_buf);
    t2 = read_buf@[1];

    d_res = case_delete_file!(arena, tmp_n0, 0);
    gone_res = case_find_artifact!(arena, tmp_n0, 0, ext_buf);

    exocall!(arena, EXOCALL_PMM_FREE, write_buf, 1, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, read_buf, 1, 0, 0);

    if ((w1 != 0) | (f1 != 0) | (r1 != 0) | (w2 != 0) | (f2 != 0) | (r2 != 0) | (d_res != 0) | (!(gone_res < 0))) [
        ret 6;
    ]
    if ((ty1 != CASE_TYPE_DATA) | (ep1 != 1) | (hs1 != h1) | (m1 != -77074246535541692) | (t1 != 1337)) [
        ret 6;
    ]
    if ((pg2 == pg1) | (ep2 != 2) | (hs2 != h2) | (t2 != 7331)) [
        ret 6;
    ]
    ret 0;
]

fn test_ring!(arena) [
    ring_ptr = arena@[ARENA_LENS_RING];
    r_push = ring_push!(ring_ptr, 30);
    pop_val = ring_pop!(ring_ptr);
    head = ring_ptr@[RING_LENS_HEAD];
    tail = ring_ptr@[RING_LENS_TAIL];
    if ((r_push != 0) | (pop_val != 30) | (head != tail)) [
        ret 7;
    ]
    ret 0;
]

fn test_scancodes!() [
    dec_err = (trg_is_break_code(30) != 0) | (trg_is_break_code(158) != 1) | (trg_update_shift_state(42, 0) != 1) | (trg_update_shift_state(170, 1) != 0);
    trg_err = (trg_scancode_to_trg(30, 0) != 26) | (trg_scancode_to_trg(30, 1) != 0) | (trg_scancode_to_trg(28, 0) != 241) | (trg_scancode_to_trg(57, 0) != 240) | (trg_scancode_to_trg(14, 0) != TRG_BS) | (trg_scancode_to_trg(158, 0) != -1) | (trg_scancode_to_trg(42, 0) != -1);
    if ((dec_err | trg_err) != 0) [
        ret 8;
    ]
    ret 0;
]

fn test_console!(arena) [
    state_ptr = arena@[ARENA_LENS_CONSOLE];
    stride = state_ptr@[CONSOLE_LENS_STRIDE];
    backbuffer = state_ptr@[CONSOLE_LENS_BACKBUFFER];
    fb_base = state_ptr@[CONSOLE_LENS_FB_BASE];

    c_lo = COLOR_BG & 4294967295;
    bg_qw = (c_lo << 32) | c_lo;

    sample_a_idx = (5 * stride) >> 3;
    sample_a = backbuffer@[sample_a_idx];
    sample_b_idx = (21 * stride + 320) >> 3;
    sample_b = backbuffer@[sample_b_idx];

    render_err = (sample_a == bg_qw) | (sample_b == bg_qw);
    if (fb_base != 0) [
        render_err = render_err | (fb_base@[sample_a_idx] != sample_a) | (fb_base@[sample_b_idx] != sample_b);
    ]
    if (render_err != 0) [
        ret 9;
    ]
    ret 0;
]

fn test_dag_cycle!(arena) [
    svc_table = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (svc_table == 0) [
        ret 12;
    ]
    loop (cl:256 = 0 .. 256) [
        svc_table@[cl] = 0;
    ]
    idx_30_deps = (30 << 2) + SVC_LENS_DEPS;
    idx_31_deps = (31 << 2) + SVC_LENS_DEPS;
    svc_table@[idx_30_deps] = 1 << 31;
    svc_table@[idx_31_deps] = 1 << 30;

    cycle_res = dag_pick_next_runnable(svc_table, (1 << 30) | (1 << 31), 0);
    exocall!(arena, EXOCALL_PMM_FREE, svc_table, 1, 0, 0);
    if (cycle_res != -1) [
        ret 12;
    ]
    ret 0;
]

fn test_lit_slots!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];

    target_slot = slot_find_free(table);
    if (target_slot < 1) [
        ret 13;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_V1_SAFE_0, 0, ext_buf) != 0) [
        ret 14;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 14;
    ]
    pg_v1    = ext_buf@[CASE_EXT_PG];
    pages_v1 = ext_buf@[CASE_EXT_PAGES];
    bytes_v1 = ext_buf@[CASE_EXT_BYTES];
    hash_v1  = ext_buf@[CASE_EXT_HASH];
    lba_v1   = pg_v1 << 3;
    secs_v1  = pages_v1 << 3;

    if (case_find_artifact!(arena, FILE_V2_SAFE_0, 0, ext_buf) != 0) [
        ret 15;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 15;
    ]
    lba_v2  = ext_buf@[CASE_EXT_PG] << 3;
    secs_v2 = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_v2 = ext_buf@[CASE_EXT_HASH];

    if (case_find_artifact!(arena, FILE_SINC_SAFE_0, FILE_SINC_SAFE_1, ext_buf) != 0) [
        ret 16;
    ]

    r_load = exocall!(arena, EXOCALL_SLOT_LOAD, target_slot, lba_v1, secs_v1, hash_v1);
    if (r_load != LIT_EXIT_OK) [
        ret 17;
    ]

    if (slot_find_by_hash(table, hash_v1) != target_slot) [
        ret 18;
    ]

    val1 = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val1 != 100) [
        ret 19;
    ]

    r_swap = exocall!(arena, EXOCALL_SLOT_HOTSWAP, target_slot, lba_v2, secs_v2, hash_v2);
    if (r_swap != LIT_EXIT_OK) [
        ret 20;
    ]

    val2 = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val2 != 200) [
        ret 21;
    ]

    exocall!(arena, EXOCALL_SLOT_UNLOAD, target_slot, 0, 0, 0);
    if (slot_is_occupied(table, target_slot) != 0) [
        ret 22;
    ]

    mem_page = exocall!(arena, EXOCALL_PMM_ALLOC, pages_v1, 0, 0, 0);
    if (mem_page == 0) [
        ret 23;
    ]
    r_nvme = case_rw_pages!(arena, 0, pg_v1, pages_v1, mem_page);
    if (r_nvme != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, mem_page, pages_v1, 0, 0);
        ret 24;
    ]
    r_load_mem = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, target_slot, mem_page, bytes_v1, hash_v1);
    exocall!(arena, EXOCALL_PMM_FREE, mem_page, pages_v1, 0, 0);
    if (r_load_mem != LIT_EXIT_OK) [
        ret 25;
    ]
    val_mem = exocall!(arena, EXOCALL_SLOT_CALL, target_slot, 0, 0, 0);
    if (val_mem != 100) [
        ret 26;
    ]
    exocall!(arena, EXOCALL_SLOT_UNLOAD, target_slot, 0, 0, 0);
    if (slot_is_occupied(table, target_slot) != 0) [
        ret 27;
    ]
    ret 0;
]

fn test_sinc_compiler!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];
    app_slot = slot_find_free(table);
    if (app_slot < 0) [
        ret 28;
    ]
    r_comp = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, app_slot);
    if (r_comp != 0) [
        ret 29;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, app_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, app_slot, 0, 0, 0);
    if (app_val != 77) [
        ret 30;
    ]
    ret 0;
]

fn test_coreutils!(arena) [
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_BUILD_SAFE_0, FILE_BUILD_SAFE_1, ext_buf) != 0) [
        ret 31;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 31;
    ]

    table = arena@[ARENA_LENS_LIT_TABLE];
    app_slot = slot_find_free(table);
    build_slot = slot_find_free_high(table);
    if ((app_slot < 1) | (!(app_slot < 10)) | (build_slot < 32)) [
        ret 32;
    ]

    lba = ext_buf@[CASE_EXT_PG] << 3;
    secs = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_val = ext_buf@[CASE_EXT_HASH];
    if (exocall!(arena, EXOCALL_SLOT_LOAD, build_slot, lba, secs, hash_val) != LIT_EXIT_OK) [
        ret 33;
    ]

    arg_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (arg_buf == 0) [
        exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
        ret 34;
    ]
    arg_buf@[0] = -1143866828831250150;
    arg_buf@[1] = 52 + app_slot;

    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    cli@[0] = arg_buf;
    cli@[1] = 9;

    b_res = exocall!(arena, EXOCALL_SLOT_CALL, build_slot, arena, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    exocall!(arena, EXOCALL_PMM_FREE, arg_buf, 1, 0, 0);

    if (b_res != 0) [
        ret 35;
    ]
    if (slot_is_occupied(table, app_slot) == 0) [
        ret 36;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, app_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, app_slot, 0, 0, 0);
    if (app_val != 77) [
        ret 37;
    ]
    ret 0;
]

fn battle_tamper_hash!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    table = arena@[ARENA_LENS_LIT_TABLE];
    t_slot = slot_find_free(table);
    if (t_slot < 1) [
        ret 101;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_V1_SAFE_0, 0, ext_buf) != 0) [
        ret 102;
    ]
    pg_v1    = ext_buf@[CASE_EXT_PG];
    pages_v1 = ext_buf@[CASE_EXT_PAGES];
    bytes_v1 = ext_buf@[CASE_EXT_BYTES];
    hash_v1  = ext_buf@[CASE_EXT_HASH];
    lba_v1   = pg_v1 << 3;
    secs_v1  = pages_v1 << 3;

    r_nvme = exocall!(arena, EXOCALL_SLOT_LOAD, t_slot, lba_v1, secs_v1, hash_v1 + 1);
    if ((r_nvme != LIT_ERR_BAD_HASH) | (slot_is_occupied(table, t_slot) != 0)) [
        ret 103;
    ]

    mem_buf = exocall!(arena, EXOCALL_PMM_ALLOC, pages_v1, 0, 0, 0);
    if (mem_buf == 0) [
        ret 104;
    ]
    if (case_rw_pages!(arena, 0, pg_v1, pages_v1, mem_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, mem_buf, pages_v1, 0, 0);
        ret 105;
    ]
    mem_buf@[4] = mem_buf@[4] + 1;
    r_mem = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, t_slot, mem_buf, bytes_v1, hash_v1);
    exocall!(arena, EXOCALL_PMM_FREE, mem_buf, pages_v1, 0, 0);
    if ((r_mem != LIT_ERR_BAD_HASH) | (slot_is_occupied(table, t_slot) != 0)) [
        ret 106;
    ]

    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if (p1 != p0) [
        ret 107;
    ]
    ret 0;
]

fn battle_cow_free_bufs!(arena, wbuf, rbuf, err) [
    if (wbuf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, wbuf, 3, 0, 0);
    ]
    if (rbuf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, rbuf, 3, 0, 0);
    ]
    ret err;
]

fn battle_cow_adversarial!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    wbuf = exocall!(arena, EXOCALL_PMM_ALLOC, 3, 0, 0, 0);
    rbuf = exocall!(arena, EXOCALL_PMM_ALLOC, 3, 0, 0, 0);
    if ((wbuf == 0) | (rbuf == 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 110);
    ]
    loop (z:1536 = 0 .. 1536) [
        wbuf@[z] = 0;
        rbuf@[z] = 0;
    ]
    wbuf@[0]    = 111111;
    wbuf@[600]  = 222222;
    wbuf@[1200] = 333333;

    if (case_write_file!(arena, CASE_TYPE_DATA, 891298331, 0, wbuf, 10000) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 111);
    ]
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, 891298331, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 112);
    ]
    pg_big    = ext_buf@[CASE_EXT_PG];
    pages_big = ext_buf@[CASE_EXT_PAGES];
    if ((pages_big != 3) | (case_rw_pages!(arena, 0, pg_big, 3, rbuf) != 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 113);
    ]
    if ((rbuf@[0] != 111111) | (rbuf@[600] != 222222) | (rbuf@[1200] != 333333)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 114);
    ]

    wbuf@[0] = 444444;
    if (case_write_file!(arena, CASE_TYPE_DATA, 841425453, 0, wbuf, 64) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 115);
    ]
    if (case_find_artifact!(arena, 841425453, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 116);
    ]
    pg_tiny1 = ext_buf@[CASE_EXT_PG];
    hs_tiny1 = ext_buf@[CASE_EXT_HASH];
    if (case_entry_epoch(ext_buf@[CASE_EXT_META]) != 1) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 117);
    ]

    w_oom = case_write_file!(arena, CASE_TYPE_DATA, 841425453, 0, wbuf, 4194304);
    if (!(w_oom < 0)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 118);
    ]

    if (case_find_artifact!(arena, 841425453, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 119);
    ]
    if ((ext_buf@[CASE_EXT_PG] != pg_tiny1) | (ext_buf@[CASE_EXT_HASH] != hs_tiny1) | (case_entry_epoch(ext_buf@[CASE_EXT_META]) != 1)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 120);
    ]
    rbuf@[0] = 0;
    if ((case_rw_pages!(arena, 0, pg_tiny1, 1, rbuf) != 0) | (rbuf@[0] != 444444)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 121);
    ]

    if (case_delete_file!(arena, 891298331, 0) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 122);
    ]
    wbuf@[0]   = 555555;
    wbuf@[600] = 666666;
    if (case_write_file!(arena, CASE_TYPE_DATA, 908603437, 0, wbuf, 6000) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 123);
    ]
    if (case_find_artifact!(arena, 908603437, 0, ext_buf) != 0) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 124);
    ]
    pg_two2 = ext_buf@[CASE_EXT_PG];
    if ((pg_two2 != pg_big) | (ext_buf@[CASE_EXT_PAGES] != 2)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 125);
    ]
    rbuf@[0]   = 0;
    rbuf@[600] = 0;
    if ((case_rw_pages!(arena, 0, pg_two2, 2, rbuf) != 0) | (rbuf@[0] != 555555) | (rbuf@[600] != 666666)) [
        ret battle_cow_free_bufs!(arena, wbuf, rbuf, 126);
    ]

    d_tiny = case_delete_file!(arena, 841425453, 0);
    d_two2 = case_delete_file!(arena, 908603437, 0);
    battle_cow_free_bufs!(arena, wbuf, rbuf, 0);
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if ((d_tiny != 0) | (d_two2 != 0) | (p1 != p0)) [
        ret 127;
    ]
    ret 0;
]

fn battle_type_slot_guards!(arena) [
    table = arena@[ARENA_LENS_LIT_TABLE];
    s_free = slot_find_free(table);
    if (s_free < 1) [
        ret 130;
    ]

    r_type = cell_compile_and_load!(arena, FILE_V1_SAFE_0, 0, s_free);
    if ((r_type != 14) | (slot_is_occupied(table, s_free) != 0)) [
        ret 131;
    ]

    if (slot_is_occupied(table, 1) == 0) [
        ret 132;
    ]
    r_occ = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, 1);
    if (r_occ != 17) [
        ret 133;
    ]

    r_oob = cell_compile_and_load!(arena, FILE_APP_TRG_0, FILE_APP_TRG_1, 64);
    if (r_oob != 16) [
        ret 134;
    ]
    ret 0;
]

fn battle_cell_abort_unwind!(arena) [
    p0 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p0, 1, 0, 0);
    table = arena@[ARENA_LENS_LIT_TABLE];
    s_free = slot_find_free(table);
    if ((s_free < 1) | (!(s_free < 10))) [
        ret 140;
    ]

    r_bad1 = cell_compile_and_load!(arena, 2317996998753327643, 0, s_free);
    if ((r_bad1 != 20) | (slot_is_occupied(table, s_free) != 0)) [
        ret 141;
    ]

    r_bad2 = cell_compile_and_load!(arena, 2317996998770104859, 0, s_free);
    if ((r_bad2 != 8) | (slot_is_occupied(table, s_free) != 0)) [
        ret 142;
    ]

    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, FILE_BUILD_SAFE_0, FILE_BUILD_SAFE_1, ext_buf) != 0) [
        ret 143;
    ]
    build_slot = slot_find_free_high(table);
    if (build_slot < 32) [
        ret 144;
    ]
    if (exocall!(arena, EXOCALL_SLOT_LOAD, build_slot, ext_buf@[CASE_EXT_PG] << 3, ext_buf@[CASE_EXT_PAGES] << 3, ext_buf@[CASE_EXT_HASH]) != LIT_EXIT_OK) [
        ret 145;
    ]
    arg_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (arg_buf == 0) [
        exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
        ret 146;
    ]
    arg_buf@[0] = -1143866828831250150;
    arg_buf@[1] = 52 + s_free;

    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    cli@[0] = arg_buf;
    cli@[1] = 9;

    b_res = exocall!(arena, EXOCALL_SLOT_CALL, build_slot, arena, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, build_slot, 0, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    exocall!(arena, EXOCALL_PMM_FREE, arg_buf, 1, 0, 0);

    if ((b_res != 0) | (slot_is_occupied(table, s_free) == 0)) [
        ret 147;
    ]
    app_val = exocall!(arena, EXOCALL_SLOT_CALL, s_free, 0, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, s_free, 0, 0, 0);
    p1 = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, p1, 1, 0, 0);
    if ((app_val != 77) | (p1 != p0)) [
        ret 148;
    ]
    ret 0;
]

