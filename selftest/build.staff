// ==========================================
// selftest/build.staff
// Hardware Invariant Proof Cell Manifest
// ==========================================

artifact selftest [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/abi_defs.sinc;
    lit/data/lit_defs.sinc;
    lit/pure/slots.sinc;
    case/data/case_defs.sinc;
    case/pure/case.sinc;
    case/pure/case_alloc.sinc;
    case/sys/case_read.sinc;
    case/sys/case_write.sinc;
    spine/sys/sinc_client.sinc;
    minit/data/minit_defs.sinc;
    minit/pure/dag.sinc;
    shark/data/console_defs.sinc;
    shark/data/cap_defs.sinc;
    shark/data/input_defs.sinc;
    shark/pure/cap.sinc;
    shark/pure/math.sinc;
    shark/sys/cap.sinc;
    shark/sys/ring.sinc;
    lit_shell/data/input_defs.sinc;
    lit_shell/pure/input.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
