// ==========================================
// steel/sys/packager_kernel_entry.sinc
// Standalone .safe to SHARK.BIN Kernel Container CLI
// ==========================================

fn main!(argc, argv_ptr) [
    if (argc != 3) [
        sys_exit!(1);
    ]

    kernel_path = argv_ptr@[1];
    out_path    = argv_ptr@[2];

    raw_mem = sys_mmap!(64000000);
    if (raw_mem == -1) [
        sys_exit!(4);
    ]
    arena = arena_init!(raw_mem, 64000000);
    res = pack_safe_to_kernel!(kernel_path, out_path, arena);
    sys_exit!(res);
]
