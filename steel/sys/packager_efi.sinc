// ==========================================
// steel/sys/packager_efi.sinc
// S.T.E.E.L. .safe to UEFI PE32+ BOOTX64.EFI Packager
// Single executable .text section (Characteristics 0xE0000020, NX=0)
// Native Win64-to-Spine 128B Trampoline & Reverse Thunk Table
// ==========================================

fn emit_pe_header!(img, raw_code_size, bss_size, total_image_size) [
    loop (i:64 = 0 .. 64) [
        img@[i] = 0;
    ]

    // 1. DOS Header (0x00..0x3F)
    img@[0] = 23117;                    // e_magic = "MZ" (0x5A4D)
    img@[7] = 274877906944;             // e_lfanew = 0x40 at byte 60 (0x40 << 32)

    // 2. PE Signature & COFF Header (0x40..0x57)
    img@[8] = 429239031579984;          // "PE\0\0" | Machine AMD64 (0x8664) | NumSections=1
    img@[9] = 0;                        // TimeDateStamp=0, SymTable=0
    img@[10] = 153686368076169216;      // NumSyms=0 | SizeOfOptionalHeader=0xF0 | Chars=0x0222

    // 3. Optional Header (PE32+, 0x58..0x147)
    img@[11] = 66059 | (raw_code_size << 32); // Magic=0x020B, Linker 1.0, SizeOfCode
    img@[12] = bss_size << 32;          // SizeOfUninitializedData (64KB BSS)
    img@[13] = 2199023256064;           // EntryPoint=0x200 | BaseOfCode=0x200
    img@[14] = 0;                       // ImageBase=0 (UEFI relocatable)
    img@[15] = 2199023256064;           // SecAlign=0x200 | FileAlign=0x200
    img@[16] = 0;                       // OS / Image version
    img@[17] = 0;                       // Subsystem version / Win32Version
    img@[18] = total_image_size | (2199023255552); // SizeOfImage | (SizeOfHeaders=0x200 << 32)
    img@[19] = 42949672960;             // Subsystem=10 (EFI Application << 32)
    img@[20] = 65536;                   // SizeOfStackReserve = 64KB
    img@[21] = 65536;                   // SizeOfStackCommit = 64KB
    img@[24] = 68719476736;             // NumberOfRvaAndSizes = 16 (16 << 32)

    // 4. Section Header (.text, 0x148..0x16F)
    img@[41] = 500236121134;            // ".text\0\0\0" (0x000000747865742E)
    img@[42] = (raw_code_size + bss_size) | (2199023255552); // VirtualSize | (VAddr 0x200 << 32)
    img@[43] = raw_code_size | (2199023255552);              // SizeOfRawData | (RawPtr 0x200 << 32)
    img@[44] = 0;                       // Relocs, Lineno
    img@[45] = -2305842871774740480;    // Characteristics = 0xE0000020 << 32 (Code|Exec|Read|Write|NX=0)
    ret 0;
]

fn emit_trampoline!(img, main_off, bss_off) [
    loop (j:64 = 0 .. 64) [
        img@[(64 + j)] = 0;
    ]

    // _efi_entry (0x0200..0x0283)
    img@[64] = 124083775378065737;
    img@[65] = -2181413880796807168;
    img@[66] = 1101341352820110106;
    img@[67] = 137564363430228154;
    img@[68] = 1101376537199911439;
    img@[69] = 786082709772036282;
    img@[70] = -2296256286117195960;
    img@[71] = 1137494256957523896;
    img@[72] = 4611967494039046562;
    img@[73] = 3534891675287552061;
    img@[74] = -3300857051870676791;
    img@[75] = -812224443960983281; // jmp 0x288 (x2APIC + TSC-Deadline check)
    img@[76] = 5259619377036505088;
    img@[77] = -8554306017254302323;
    img@[78] = 928602343646;

    // Call stabl_main: displacement = (1024 + main_off) - 0x283 = 0x17D + main_off
    disp = 381 + main_off;
    img@[79] = 65560070018140492 | ((disp & 255) << 56);
    img@[80] = ((disp >> 8) & 16777215) | (195 << 24);

    // Require x2APIC (ECX[21]) + TSC-Deadline (ECX[24]) at 0x288..0x2A8; halt out 0xF4, 6 on failure
    img@[81] = 1137494256957522360;
    img@[82] = -9150997783453269598;
    img@[83] = 7406297135391441145;
    img@[84] = -1444267867989019462;
    img@[85] = -8029759185026510595;

    // efi_call5 (0x02C0, Words 88..93)
    // Enforces 16-byte stack alignment (and rsp, -16) before call *%r11
    img@[88] = 5212730012037892181;
    img@[89] = 5273975212259468419;
    img@[90] = -2699546436843287671;
    img@[91] = -1114279030401234612;
    img@[92] = -8266124022761551543;
    img@[93] = 54990267465328741;

    // stabl_jump_kernel (0x02F0, Word 94):
    // cli; mov %rbx, %rsp; jmp *%rdx; nop; nop
    // Takes 3 Spine ABI args: (boot_info in RCX, entry_addr in RDX, stack_top in RBX)
    img@[94] = -8029668547057071878;

    // Scratch BSS Offset Slot (0x0350, Word 106; 0x0340/0x0348/0x0358 zeroed)
    img@[106] = bss_off;

    // Reverse Thunk Table (0x0360..0x03FF, Words 108..127)
    // Words 108..109 (0x0360: Thunk 5 - stabl_rdtsc: lfence; rdtsc; shl 32; or; ret)
    img@[108] = -2107323775075176945;
    img@[109] = -8029758964918302688;
    // Word 112 (0x0380: Thunk 4 - stabl_jump_kernel bridge: jmp 0x02F0)
    img@[112] = -8029758706415604759;
    // Word 116 (0x03A0: Thunk 3 - io_out32 inline)
    img@[116] = 55151273626226825;
    // Word 120 (0x03C0: Thunk 2 - io_in32 inline)
    img@[120] = 841508096358;
    // Word 124 (0x03E0: Thunk 1 - efi_call5 bridge: jmp 0x02C0)
    img@[124] = 1099511553001;
    ret 0;
]

fn pack_safe_to_efi!(stabl_path, efi_path, arena) [
    stabl_fd = sys_open_read!(stabl_path);
    if (stabl_fd < 0) [
        ret 1;
    ]

    header_buf = arena_alloc_words!(arena, 4);
    hbytes = sys_read!(stabl_fd, header_buf, 32);
    if (hbytes != 32) [
        sys_close!(stabl_fd);
        ret 2;
    ]

    magic = header_buf@[0] & 4294967295;
    version = header_buf@[0] >> 32;
    stabl_code_len = header_buf@[1];
    stabl_main_off = header_buf@[2];
    if ((magic != 1396786245) | (version != 1) | (header_buf@[3] != 32) | (!(stabl_main_off < stabl_code_len))) [
        sys_close!(stabl_fd);
        ret 2;
    ]

    total_code_size = 1024 + stabl_code_len;
    raw_code_size = (total_code_size - 512 + 511) & -512;
    bss_size = 65536;
    virt_code_size = (total_code_size - 512 + bss_size + 511) & -512;
    total_image_size = 512 + virt_code_size;
    total_file_size = 512 + raw_code_size;
    bss_off = 512 + raw_code_size;

    efi_fd = sys_open_write!(efi_path);
    if (efi_fd < 0) [
        sys_close!(stabl_fd);
        ret 3;
    ]

    total_words = (total_file_size + 7) >> 3;
    img = arena_alloc_words!(arena, total_words);
    loop (w:1000000 = 0 .. total_words) [
        img@[w] = 0;
    ]

    emit_pe_header!(img, raw_code_size, bss_size, total_image_size);
    emit_trampoline!(img, stabl_main_off, bss_off);

    read_bytes = sys_read!(stabl_fd, img + 1024, stabl_code_len);
    sys_close!(stabl_fd);
    if (read_bytes != stabl_code_len) [
        sys_close!(efi_fd);
        ret 4;
    ]

    written = sys_write!(efi_fd, img, total_file_size);
    sys_close!(efi_fd);
    if (written != total_file_size) [
        ret 6;
    ]

    ret 0;
]
