// ==========================================
// steel/sys/packager_efi_entry.sinc
// Standalone SINC .safe to UEFI PE32+ BOOTX64.EFI CLI
// ==========================================

fn main!(argc, argv_ptr) [
    if (argc < 3) [
        sys_exit!(1);
    ]

    stabl_path  = argv_ptr@[1];
    kernel_path = 0;
    efi_path    = 0;
    font_path   = 0;

    if (argc == 3) [
        efi_path = argv_ptr@[2];
    ] else [
        kernel_path = argv_ptr@[2];
        efi_path    = argv_ptr@[3];
        if (argc > 4) [
            font_path = argv_ptr@[4];
        ]
    ]

    raw_mem = sys_mmap!(64000000); // 64MB Arena
    if (raw_mem == -1) [
        sys_exit!(4); // Out of system memory
    ]
    arena = arena_init!(raw_mem, 64000000);
    res = pack_safe_to_efi!(stabl_path, kernel_path, efi_path, font_path, arena);
    sys_exit!(res);
]
