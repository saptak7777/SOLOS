// ==========================================
// steel/sys/packager_efi_entry.sinc
// Standalone SINC .safe to UEFI PE32+ BOOTX64.EFI CLI
// ==========================================

fn main!(argc, argv_ptr) [
    if (argc != 3) [
        sys_exit!(1);
    ]

    stabl_path = argv_ptr@[1];
    efi_path   = argv_ptr@[2];

    raw_mem = sys_mmap!(64000000); // 64MB Arena
    if (raw_mem == -1) [
        sys_exit!(4); // Out of system memory
    ]
    arena = arena_init!(raw_mem, 64000000);
    res = pack_safe_to_efi!(stabl_path, efi_path, arena);
    sys_exit!(res);
]
