// ==========================================
// shark/sys/pic.sinc
// 8259 PIC, 8254 PIT, and PS/2 8042 Driver
// ==========================================

fn pic_init!(master_base, slave_base) [
    io_out8!(PIC1_COMMAND, 17);
    io_out8!(PIC2_COMMAND, 17);
    io_out8!(PIC1_DATA, master_base);
    io_out8!(PIC2_DATA, slave_base);
    io_out8!(PIC1_DATA, 4);
    io_out8!(PIC2_DATA, 2);
    io_out8!(PIC1_DATA, 1);
    io_out8!(PIC2_DATA, 1);
    io_out8!(PIC1_DATA, 255);
    io_out8!(PIC2_DATA, 255);
    ret 0;
]

fn pit_init!(freq_hz) [
    divisor = 1193182 / freq_hz;
    lo = divisor & 255;
    hi = (divisor >> 8) & 255;
    io_out8!(PIT_COMMAND, 54);
    io_out8!(PIT_CHANNEL0, lo);
    io_out8!(PIT_CHANNEL0, hi);
    ret 0;
]

fn ps2_drain!() [
    loop (d:16 = 0 .. 16) [
        status = io_in8!(PS2_STATUS);
        if ((status & 1) != 0) [
            dummy = io_in8!(PS2_DATA);
        ]
    ]
    ret 0;
]

fn pic_unmask_irq!(irq_line) [
    if (irq_line < 8) [
        mask = io_in8!(PIC1_DATA);
        new_mask = mask & (255 - (1 << irq_line));
        io_out8!(PIC1_DATA, new_mask);
    ]
    if (!(irq_line < 8)) [
        slave_line = irq_line - 8;
        mask = io_in8!(PIC2_DATA);
        new_mask = mask & (255 - (1 << slave_line));
        io_out8!(PIC2_DATA, new_mask);
        m_mask = io_in8!(PIC1_DATA);
        io_out8!(PIC1_DATA, m_mask & 251);
    ]
    ret 0;
]

