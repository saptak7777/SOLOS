// ==========================================
// shark/sys/entry.sinc
// SHARK Ring 0 Exokernel Hardware Multiplexer (Strict Law 15)
// ==========================================

fn exocall_dispatch!(arena, op, a1, a2, a3, a4) [
    if (op == EXOCALL_GET_FN_ADDR) [
        ret cpu_get_fn_addr!();
    ]
    if (op == EXOCALL_SLOT_LOAD) [
        ret lit_slot_load!(arena, a1, a2, a3, a4);
    ]
    if (op == EXOCALL_SLOT_CALL) [
        ret lit_slot_call!(arena, a1, a2);
    ]
    if (op == EXOCALL_SLOT_HOTSWAP) [
        ret lit_slot_hotswap!(arena, a1, a2, a3, a4);
    ]
    if (op == EXOCALL_SLOT_UNLOAD) [
        ret lit_slot_unload!(arena, a1);
    ]
    if (op == EXOCALL_PMM_ALLOC) [
        if (a1 < 1) [
            ret 0;
        ]
        pmm = arena@[ARENA_LENS_PMM];
        ret pmm_alloc_contiguous!(pmm, a1);
    ]
    if (op == EXOCALL_PMM_FREE) [
        if (a2 < 1) [
            ret 1;
        ]
        pmm = arena@[ARENA_LENS_PMM];
        f_err = 0;
        loop (f:4096 = 0 .. a2) [
            r_f = pmm_free_page!(pmm, a1 + (f << 12));
            if (r_f != 0) [
                f_err = r_f;
            ]
        ]
        ret f_err;
    ]
    if (op == EXOCALL_NVME_RW) [
        nvme = arena@[ARENA_LENS_NVME];
        ret nvme_rw_sectors!(nvme, a1, a2, a3, a4);
    ]
    if (op == EXOCALL_SLEEP_US) [
        timer_ticks_ptr = arena@[ARENA_LENS_TIMER];
        xhci = arena@[ARENA_LENS_XHCI];
        ret tsc_sleep_us!(timer_ticks_ptr, a1, a2, xhci);
    ]
    if (op == EXOCALL_SLOT_LOAD_MEM) [
        ret lit_slot_load_mem!(arena, a1, a2, a3, a4);
    ]
    if (op == EXOCALL_INPUT_POLL) [
        ret xhci_poll!(arena@[ARENA_LENS_XHCI]);
    ]
    ret -1;
]

fn console_render_telemetry!(state_ptr, cpu_caps, ram_count, storage_bar, pmm) [
    console_set_color!(state_ptr, COLOR_DIVIDER, COLOR_BG);
    console_print_divider!(state_ptr, 117);
    console_set_color!(state_ptr, COLOR_FG_CYAN, COLOR_BG);
    console_print_qword!(state_ptr, STR_BOOT_PREFIX, 8);
    console_putc!(state_ptr, 240);
    console_set_color!(state_ptr, COLOR_FG_WHITE, COLOR_BG);
    console_print_qword!(state_ptr, STR_SHARK_V0, 8);
    console_newline!(state_ptr);
    console_set_color!(state_ptr, COLOR_DIVIDER, COLOR_BG);
    console_print_divider!(state_ptr, 117);
    console_flush_screen!(state_ptr);
    ret 0;
]

fn kernel_halt_err!(code) [
    io_out32!(TRG_DEBUG_PORT, code);
    cpu_halt!();
    ret 1;
]

fn kernel_free_pages!(pmm, base, num_pages) [
    loop (fp:8 = 0 .. num_pages) [
        pmm_free_page!(pmm, base + (fp << 12));
    ]
    ret 0;
]

fn kernel_main!(boot_info) [
    if (boot_info == 0) [
        ret kernel_halt_err!(ERR_BAD_BOOT_INFO);
    ]
    if (boot_info@[BOOT_LENS_MAGIC_VER] != BOOT_INFO_MAGIC_VER) [
        ret kernel_halt_err!(ERR_BAD_BOOT_INFO);
    ]

    shark_base = boot_info@[BOOT_LENS_SHARK_BASE];
    shark_size = boot_info@[BOOT_LENS_SHARK_SIZE];
    shark_hash = boot_info@[BOOT_LENS_SHARK_HASH];
    font_base  = boot_info@[BOOT_LENS_FONT_BASE];
    font_size  = boot_info@[BOOT_LENS_FONT_SIZE];
    font_hash  = boot_info@[BOOT_LENS_FONT_HASH];
    if ((shark_base == 0) | (!(shark_size > SHARK_BIN_CODE_OFF)) | (font_base == 0) | (font_size != 4096)) [
        ret kernel_halt_err!(ERR_BAD_BOOT_INFO);
    ]
    // Verify loaded image & font hashes before cpu_init! patches k_cpu slots
    if ((case_fnv1a_64(shark_base, shark_size) != shark_hash) | (case_fnv1a_64(font_base, font_size) != font_hash)) [
        ret kernel_halt_err!(ERR_BAD_BOOT_INFO);
    ]

    fb_base     = boot_info@[BOOT_LENS_FB_BASE];
    dims        = boot_info@[BOOT_LENS_FB_DIMS];
    stride_caps = boot_info@[BOOT_LENS_FB_STRIDE_CAPS];
    ram_tape    = boot_info@[BOOT_LENS_RAM_TAPE];
    ram_count   = boot_info@[BOOT_LENS_REGION_COUNT];
    storage_bar = boot_info@[BOOT_LENS_STORAGE_BAR];
    xhci_bar    = boot_info@[BOOT_LENS_XHCI_BAR];
    tsc_khz     = boot_info@[BOOT_LENS_TSC_KHZ];
    if (tsc_khz < 10000) [
        ret kernel_halt_err!(ERR_BAD_BOOT_INFO);
    ]

    width = (dims >> 32) & 4294967295;
    height = dims & 4294967295;
    stride = (stride_caps >> 32) & 4294967295;
    cpu_caps = stride_caps & 4294967295;

    // 1. Hardware CPU Bring-up (GDT, TSS, IDT, IST Handlers)
    cpu_init!(ram_tape, fb_base);

    // 2. Hardware PMM Bring-up
    pmm = pmm_init!(ram_tape, ram_count);
    if (pmm == 0) [
        cpu_halt!();
        ret 1;
    ]

    // 3. Hardware Console & Backbuffer Bring-up
    bss_base = ram_tape - 49216;
    fb_bytes = stride * height;
    fb_pages = (fb_bytes + 4095) >> 12;
    backbuffer = pmm_alloc_contiguous!(pmm, fb_pages);
    if (backbuffer == 0) [
        ret kernel_halt_err!(ERR_CONSOLE_OOM);
    ]

    state_ptr = bss_base + 25088;
    state_ptr@[CONSOLE_LENS_FB_BASE] = fb_base;
    state_ptr@[CONSOLE_LENS_BACKBUFFER] = backbuffer;
    state_ptr@[CONSOLE_LENS_FONT_PTR] = font_base;
    state_ptr@[CONSOLE_LENS_WIDTH] = width;
    state_ptr@[CONSOLE_LENS_HEIGHT] = height;
    state_ptr@[CONSOLE_LENS_STRIDE] = stride;
    console_init!(state_ptr);
    console_render_telemetry!(state_ptr, cpu_caps, ram_count, storage_bar, pmm);

    // 4. EROS Capability Table Bring-up
    cap_table = bss_base + CAP_TABLE_BSS_OFFSET;
    live_mask_ptr = bss_base + LIVE_SIP_BSS_OFFSET;
    cap_init_table!(cap_table, live_mask_ptr);

    // 5. NVMe Hardware Controller Bring-up (TSC-Calibrated Deadlines)
    nvme = 0;
    if ((cpu_caps & 2) != 0) [
        nvme = nvme_init!(storage_bar, pmm, tsc_khz);
        if ((nvme == 0) | (nvme_create_io_queues!(nvme, pmm) != 0)) [
            ret kernel_halt_err!(ERR_NVME_TIMEOUT);
        ]
    ]

    // 6. Legacy-Free x2APIC, TSC-Deadline, Input Ring & xHCI USB Bring-up
    timer_ticks_ptr = bss_base + TIMER_BSS_OFFSET;
    timer_ticks_ptr@[TIMER_LENS_XHCI_SEQ] = 0;
    ring_ptr = bss_base + RING_BSS_OFFSET;
    ring_init!(ring_ptr);
    apic_init!(ram_tape, tsc_khz);
    cpu_init_irqs!(ram_tape);
    xhci_bdf = (cpu_caps >> 8) & 65535;
    xhci = xhci_init!(xhci_bar, xhci_bdf, pmm, ring_ptr, tsc_khz);

    // 7. Pack Linear Arena Exchange Table
    cr3_base = paging_get_cr3_base!();
    table = bss_base + LIT_TABLE_BSS_OFFSET;
    meta_buf = bss_base + 32768;
    arena_ptr = bss_base + ARENA_BSS_OFFSET;
    dispatch_fn = exocall_dispatch!(0, 0, 0, 0, 0, 0);

    arena_ptr@[ARENA_LENS_PMM]       = pmm;
    arena_ptr@[ARENA_LENS_CONSOLE]   = state_ptr;
    arena_ptr@[ARENA_LENS_NVME]      = nvme;
    arena_ptr@[ARENA_LENS_RING]      = ring_ptr;
    arena_ptr@[ARENA_LENS_TIMER]     = timer_ticks_ptr;
    arena_ptr@[ARENA_LENS_CAP_TABLE] = cap_table;
    arena_ptr@[ARENA_LENS_LIVE_MASK] = live_mask_ptr;
    arena_ptr@[ARENA_LENS_TOKEN]     = 1;
    arena_ptr@[ARENA_LENS_CR3]       = cr3_base;
    arena_ptr@[ARENA_LENS_LIT_TABLE] = table;
    arena_ptr@[ARENA_LENS_META_BUF]  = meta_buf;
    arena_ptr@[ARENA_LENS_EXOCALL]   = dispatch_fn;
    arena_ptr@[ARENA_LENS_BOOT_INFO] = boot_info;
    arena_ptr@[ARENA_LENS_XHCI]      = xhci;

    loop (cl:256 = 0 .. 256) [
        table@[cl] = 0;
    ]

    free_before = pmm@[PMM_LENS_FREE_PAGES];
    meta_buf@[3] = 0;

    // 8. Boot Slot 0: resolve minit.safe dynamically via 2-page CASE Superblock & Table
    if (nvme != 0) [
        tbl_buf = pmm_alloc_contiguous!(pmm, CASE_TABLE_PAGES);
        if (tbl_buf == 0) [
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        if (nvme_rw_sectors!(nvme, 0, CASE_SB_LBA, 8, tbl_buf) != 0) [
            kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        if ((tbl_buf@[CASE_SB_LENS_MAGIC] != CASE_MAGIC) | (tbl_buf@[CASE_SB_LENS_VER] != CASE_VERSION)) [
            kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        t_err = 0;
        loop (tp:8 = 0 .. CASE_TABLE_PAGES) [
            if (t_err == 0) [
                if (nvme_rw_sectors!(nvme, 0, (CASE_TABLE_START_PG + tp) << 3, 8, tbl_buf + (tp << 12)) != 0) [
                    t_err = 1;
                ]
            ]
        ]
        if (t_err != 0) [
            kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        m_idx = case_lookup(tbl_buf, FILE_MINIT_SAFE_0, FILE_MINIT_SAFE_1);
        if (m_idx < 0) [
            kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        m_base = m_idx << 3;
        m_meta = tbl_buf@[(m_base + CASE_LENS_META)];
        if (case_entry_type(m_meta) != CASE_TYPE_SAFE) [
            kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]
        m_lba  = tbl_buf@[(m_base + CASE_LENS_START_PG)] << 3;
        m_secs = case_entry_pages(m_meta) << 3;
        m_hash = tbl_buf@[(m_base + CASE_LENS_HASH)];
        kernel_free_pages!(pmm, tbl_buf, CASE_TABLE_PAGES);

        r_load = lit_slot_load!(arena_ptr, 0, m_lba, m_secs, m_hash);
        if (r_load != LIT_EXIT_OK) [
            ret kernel_halt_err!(ERR_LIT_LOAD);
        ]

        minit_ret = lit_slot_call!(arena_ptr, 0, arena_ptr);
        lit_slot_unload!(arena_ptr, 0);
        free_after = pmm@[PMM_LENS_FREE_PAGES];

        if ((minit_ret != 0) | ((free_after + meta_buf@[3]) != free_before)) [
            ret kernel_halt_err!(ERR_LIT_PARITY);
        ]
    ]

    // 9. Signal Success to TRG debug port 0xF4 & Clean Halt
    io_out32!(TRG_DEBUG_PORT, TEST_PASS_CODE);
    cpu_halt!();
    ret 0;
]
