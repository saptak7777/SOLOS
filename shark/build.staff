// ==========================================
// shark/build.staff
// SHARK: SINC-Hosted Artifact Ring-0 Kernel Manifest
// ==========================================

artifact shark [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/boot_defs.sinc;
    spine/data/abi_defs.sinc;
    spine/data/input_defs.sinc;
    spine/pure/input_evt.sinc;
    case/data/case_defs.sinc;
    case/pure/case.sinc;
    lit/data/lit_defs.sinc;
    lit/pure/safe_header.sinc;
    lit/sys/paging.sinc;
    lit/sys/thunks.sinc;
    lit/sys/runner.sinc;
    lit/sys/slot_runner.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
