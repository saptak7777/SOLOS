const TRG_DEBUG_PORT = 244; // 0xF4
const TEST_PASS_CODE = 42;

// GDT Descriptors & Selectors
const GDT_CODE_DESC  = 49427445715107839; // 0x00AF9A000000FFFF: Ring 0 64-bit Code (0x08)
const GDT_DATA_DESC  = 58425848876826623; // 0x00CF92000000FFFF: Ring 0 64-bit Data (0x10)
const GDT_LIMIT      = 39;                // 5 entries * 8 - 1 = 39 (0x27)

// TSS Descriptors & Offsets
const TSS_LIMIT      = 103; // 104 bytes - 1 = 103 (0x67)
const TSS_TYPE_ATTR  = 137; // 0x89: Present, Ring 0, 64-bit Available TSS
const TSS_IOMAP_BASE = 104; // 0x68: Offset to I/O bitmap (none)

// IDT Descriptors & Selectors
const IDT_GATE_ATTR  = 142;  // 0x8E: Present, Ring 0, 64-bit Interrupt Gate
const IDT_CODE_SEL   = 8;    // 0x08: CS selector
const IDT_LIMIT      = 4095; // 256 entries * 16 - 1 = 4095 (0x0FFF)

// PMM & Console Errors
const ERR_PMM_NO_RAM       = 20;
const ERR_PMM_OOM          = 21;
const ERR_CONSOLE_OOM      = 40;

// Pure TRG Telemetry & Title QWORD Constants (Signed Little-Endian i64)
const STR_SHARK_V0            = 3760488139903207186;  // "SHARK v0" (len 8)
const STR_BOOT_PREFIX         = -643154868458557200;  // "  [BOOT]" (len 8)
const STR_TAG_CPU             = 264943984116470;      // "[CPU] "   (len 6)
