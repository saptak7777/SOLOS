const STR_TAG_RAM             = 264943848919542;      // "[RAM] "   (len 6)
const STR_TAG_NVME            = 67825591165193718;    // "[NVME] "  (len 7)
const STR_TAG_GOP             = 264943900165878;      // "[GOP] "   (len 6)
const STR_TAG_TRG             = 264943749370870;      // "[TRG] "   (len 6)
const STR_TAG_READY           = -1083370784195079690; // "[READY] " (len 8)
const STR_REGIONS             = 3181555788793392112;  // " regions" (len 8)
const STR_AVX512              = -1137663335037725440; // "AVX-512 " (len 8)
const STR_AVX2                = -1085102595705989888; // "AVX2    " (len 8)
const STR_FREE                = -1144444084737246480; // " | free " (len 8)
const STR_MAX                 = -1085313521804086288; // " / max  " (len 8)

// Milestone 7: Linear Exchange Arena & Sovereign Cell Lenses
