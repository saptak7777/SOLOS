// ==========================================
// shark/data/apic_defs.sinc
// SHARK x2APIC & TSC-Deadline Timer Constants
// ==========================================

// x2APIC & TSC-Deadline MSRs
const MSR_IA32_APIC_BASE    = 27;     // 0x1B
const APIC_BASE_X2APIC      = 1024;   // Bit 10: EXTD
const APIC_BASE_EN          = 2048;   // Bit 11: EN
const MSR_X2APIC_ID         = 2050;   // 0x802
const MSR_X2APIC_EOI        = 2059;   // 0x80B
const MSR_X2APIC_SVR        = 2063;   // 0x80F
const MSR_X2APIC_ESR        = 2088;   // 0x828
const MSR_X2APIC_LVT_TIMER  = 2098;   // 0x832
const MSR_X2APIC_LVT_LINT0  = 2101;   // 0x835
const MSR_X2APIC_LVT_LINT1  = 2102;   // 0x836
const MSR_IA32_TSC_DEADLINE = 1760;   // 0x6E0

const APIC_LVT_MASKED       = 65536;  // 0x10000
const APIC_LVT_TSC_DEADLINE = 262144; // 0x40000 (Timer mode = 10b)
const APIC_VECTOR_TIMER     = 32;
const APIC_VECTOR_XHCI      = 33;

// Pinned Timer BSS Offsets (ram_tape - 49216)
const TIMER_BSS_OFFSET      = 26240;
const TIMER_LENS_TICKS      = 0;
const TIMER_LENS_TSC_KHZ    = 1;

