// ==========================================
// shark/pure/cap.sinc
// SHARK Pure EROS Capability Logic (Strict Law 15)
// ==========================================

fn cap_pack_token(sip_id, epoch, slot_idx) [
    ret ((sip_id & 65535) << 48) | ((epoch & 65535) << 32) | (slot_idx & 4294967295);
]

fn cap_validate_token(token, table_base, live_mask) [
    sip_id = (token >> 48) & 65535;
    slot_idx = token & 4294967295;
    if ((!(sip_id < 64)) | (((live_mask >> sip_id) & 1) == 0) | (!(slot_idx < MAX_CAP_SLOTS))) [
        ret 0;
    ]
    if (((token >> 32) & 65535) != (table_base@[slot_idx] & 65535)) [
        ret 0;
    ]
    ret 1;
]

