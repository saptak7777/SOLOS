// ==========================================
// spine/sys/sinc_client.sinc
// Shared Live-on-Time SINC Compiler Cell Client (Strict Law 15)
// ==========================================

fn cell_compile_and_load!(arena, src_n0, src_n1, target_slot) [
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (case_find_artifact!(arena, src_n0, src_n1, ext_buf) != 0) [
        ret 1;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_TRG) [
        ret 14;
    ]
    src_pg    = ext_buf@[CASE_EXT_PG];
    src_pages = ext_buf@[CASE_EXT_PAGES];
    src_sz    = ext_buf@[CASE_EXT_BYTES];
    if ((src_pages == 0) | (src_sz == 0)) [
        ret 2;
    ]

    if (case_find_artifact!(arena, FILE_SINC_SAFE_0, FILE_SINC_SAFE_1, ext_buf) != 0) [
        ret 3;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        ret 15;
    ]
    cc_pg    = ext_buf@[CASE_EXT_PG];
    cc_pages = ext_buf@[CASE_EXT_PAGES];
    cc_sz    = ext_buf@[CASE_EXT_BYTES];
    cc_hash  = ext_buf@[CASE_EXT_HASH];
    if ((cc_pages == 0) | (cc_sz == 0)) [
        ret 4;
    ]

    table = arena@[ARENA_LENS_LIT_TABLE];
    if ((target_slot < 1) | (!(target_slot < LIT_MAX_SLOTS))) [
        ret 16;
    ]
    if (slot_is_occupied(table, target_slot) != 0) [
        ret 17;
    ]
    cc_slot = slot_find_free(table);
    if (cc_slot < 0) [
        ret 5;
    ]

    cc_buf = exocall!(arena, EXOCALL_PMM_ALLOC, cc_pages, 0, 0, 0);
    if (cc_buf == 0) [
        ret 6;
    ]
    if (case_rw_pages!(arena, 0, cc_pg, cc_pages, cc_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, cc_buf, cc_pages, 0, 0);
        ret 7;
    ]
    r_cc_load = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, cc_slot, cc_buf, cc_sz, cc_hash);
    exocall!(arena, EXOCALL_PMM_FREE, cc_buf, cc_pages, 0, 0);
    if (r_cc_load != 0) [
        ret 8;
    ]

    src_alloc_pages = (src_sz + 8 + 4095) >> 12;
    if (src_pages > src_alloc_pages) [
        src_alloc_pages = src_pages;
    ]
    src_buf = exocall!(arena, EXOCALL_PMM_ALLOC, src_alloc_pages, 0, 0, 0);
    if (src_buf == 0) [
        exocall!(arena, EXOCALL_SLOT_UNLOAD, cc_slot, 0, 0, 0);
        ret 9;
    ]
    if (case_rw_pages!(arena, 0, src_pg, src_pages, src_buf) != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, src_buf, src_alloc_pages, 0, 0);
        exocall!(arena, EXOCALL_SLOT_UNLOAD, cc_slot, 0, 0, 0);
        ret 10;
    ]
    loop (pad:8 = 0 .. 8) [
        src_buf@[(src_sz + pad) * 1] = 0;
    ]

    req_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (req_buf == 0) [
        exocall!(arena, EXOCALL_PMM_FREE, src_buf, src_alloc_pages, 0, 0);
        exocall!(arena, EXOCALL_SLOT_UNLOAD, cc_slot, 0, 0, 0);
        ret 11;
    ]

    comp_arena = exocall!(arena, EXOCALL_PMM_ALLOC, 2048, 0, 0, 0);
    if (comp_arena == 0) [
        exocall!(arena, EXOCALL_PMM_FREE, req_buf, 1, 0, 0);
        exocall!(arena, EXOCALL_PMM_FREE, src_buf, src_alloc_pages, 0, 0);
        exocall!(arena, EXOCALL_SLOT_UNLOAD, cc_slot, 0, 0, 0);
        ret 12;
    ]

    req_buf@[0] = src_buf;
    req_buf@[1] = src_sz + 8;
    req_buf@[2] = comp_arena;
    req_buf@[3] = 2048 << 12;
    req_buf@[4] = 0;
    req_buf@[5] = 0;

    r_comp = exocall!(arena, EXOCALL_SLOT_CALL, cc_slot, req_buf, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, cc_slot, 0, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, src_buf, src_alloc_pages, 0, 0);

    out_ret = r_comp;
    if (r_comp == 0) [
        out_ptr = req_buf@[4];
        out_len = req_buf@[5];
        if ((out_ptr == 0) | (out_len < 32)) [
            out_ret = 13;
        ]
        if ((out_ptr != 0) & (!(out_len < 32))) [
            out_hash = case_fnv1a_64(out_ptr, out_len);
            out_ret = exocall!(arena, EXOCALL_SLOT_LOAD_MEM, target_slot, out_ptr, out_len, out_hash);
        ]
    ]

    exocall!(arena, EXOCALL_PMM_FREE, comp_arena, 2048, 0, 0);
    exocall!(arena, EXOCALL_PMM_FREE, req_buf, 1, 0, 0);
    ret out_ret;
]
