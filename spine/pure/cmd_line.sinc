// ==========================================
// spine/pure/cmd_line.sinc
// Shared Pure TRG Command Line Parsing & .safe Name Helpers (Strict Law 15)
// ==========================================

fn shell_get_word_len(buf, start, max_len) [
    len = 0;
    stopped = 0;
    loop (i:64 = 0 .. 64) [
        if (stopped == 0) [
            pos = start + i;
            if (pos < max_len) [
                if (buf@[pos * 1] != 240) [
                    len = len + 1;
                ]
                if (buf@[pos * 1] == 240) [
                    stopped = 1;
                ]
            ]
        ]
    ]
    ret len;
]

fn shell_read_word_qw(buf, start, max_len) [
    val = 0;
    stopped = 0;
    loop (i:8 = 0 .. 8) [
        if (stopped == 0) [
            pos = start + i;
            if (pos < max_len) [
                ch = buf@[pos * 1];
                if (ch != 240) [
                    shift = i << 3;
                    val = val | (ch << shift);
                ]
                if (ch == 240) [
                    stopped = 1;
                ]
            ]
        ]
    ]
    ret val;
]

fn shell_skip_word(buf, idx, max_len) [
    done_word = 0;
    loop (i:64 = 0 .. 64) [
        if (idx < max_len) [
            ch = buf@[idx * 1];
            if (done_word == 0) [
                if (ch == 240) [
                    done_word = 1;
                ]
                if (ch != 240) [
                    idx = idx + 1;
                ]
            ]
            if (done_word != 0) [
                if (ch == 240) [
                    idx = idx + 1;
                ]
            ]
        ]
    ]
    ret idx;
]

fn shell_parse_dec(buf, idx, max_len) [
    val = 0;
    stopped = 0;
    loop (i:16 = 0 .. 16) [
        if (stopped == 0) [
            pos = idx + i;
            if (pos < max_len) [
                ch = buf@[pos * 1];
                if ((ch > 51) & (ch < 62)) [
                    digit = ch - 52;
                    val = (val * 10) + digit;
                ]
                if (!((ch > 51) & (ch < 62))) [
                    stopped = 1;
                ]
            ]
        ]
    ]
    ret val;
]

fn shell_parse_name!(buf, idx, max_len, out_pair) [
    w_len = shell_get_word_len(buf, idx, max_len);
    if (w_len == 0) [
        ret 0;
    ]
    n0 = 0;
    n1 = 0;
    if (!(w_len > 8)) [
        n0 = shell_read_word_qw(buf, idx, max_len);
    ]
    if (w_len > 8) [
        n0 = shell_read_word_qw(buf, idx, (idx + 8));
        n1 = shell_read_word_qw(buf, (idx + 8), (idx + w_len));
    ]
    out_pair@[0] = n0;
    out_pair@[1] = n1;
    ret w_len;
]

fn cmd_append_ext!(buf, w_len, ext_qw, out_pair) [
    if ((w_len == 0) | (w_len > 11)) [
        ret 0;
    ]
    out_pair@[0] = 0;
    out_pair@[1] = 0;
    loop (i:11 = 0 .. w_len) [
        out_pair@[i * 1] = buf@[i * 1];
    ]
    loop (k:5 = 0 .. 5) [
        ext_b = (ext_qw >> (k << 3)) & 255;
        out_pair@[(w_len + k) * 1] = ext_b;
    ]
    ret w_len + 5;
]
