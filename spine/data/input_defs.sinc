// ==========================================
// spine/data/input_defs.sinc
// Unified 64-Bit InputEvent Contract & Control TRG Keys (Strict Law 15)
// Layout: [pad:8(0) | type:8 | mods:8 | key:16 | arg_b:16 | aux:8]
// Rule: Top byte MUST stay 0 so packed events are non-negative (< 0 == empty ring)
// ==========================================

const EVT_KEY_DOWN    = 1;
const EVT_KEY_UP      = 2;
const EVT_WIN_FOCUS   = 3;
const EVT_WIN_CLOSE   = 4;

// Keyboard Modifier Bitmap (HID Boot Byte 0)
const MOD_LCTRL       = 1;
const MOD_LSHIFT      = 2;
const MOD_LALT        = 4;
const MOD_LGUI        = 8;
const MOD_RCTRL       = 16;
const MOD_RSHIFT      = 32;
const MOD_RALT        = 64;
const MOD_RGUI        = 128;
const MOD_ANY_SHIFT   = 34;

// Canonical Control & Arrow TRG Symbols
const TRG_ESC         = 233;
const TRG_ARROW_RIGHT = 234;
const TRG_ARROW_LEFT  = 235;
const TRG_ARROW_DOWN  = 236;
const TRG_ARROW_UP    = 237;
const TRG_BS          = 238;
const TRG_NONE        = 239;
const TRG_SPC         = 240;
const TRG_RET         = 241;
const TRG_TAB         = 242;
