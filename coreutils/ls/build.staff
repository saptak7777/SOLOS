// ==========================================
// coreutils/ls/build.staff
// On-Demand CASE Artifact Listing Cell Manifest
// ==========================================

artifact ls [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/abi_defs.sinc;
    spine/data/cli_defs.sinc;
    case/data/case_defs.sinc;
    case/pure/case.sinc;
    case/sys/case_read.sinc;
    shark/data/console_defs.sinc;
    shark/pure/math.sinc;
    shark/sys/console.sinc;
]

driver [
    coreutils/ls/sys/entry.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
