// ==========================================
// coreutils/cat/build.staff
// On-Demand CASE Artifact Print Cell Manifest
// ==========================================

artifact cat [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/abi_defs.sinc;
    spine/data/cli_defs.sinc;
    spine/pure/cmd_line.sinc;
    case/data/case_defs.sinc;
    case/pure/case.sinc;
    case/sys/case_read.sinc;
    shark/data/console_defs.sinc;
    shark/pure/math.sinc;
    shark/sys/console.sinc;
]

driver [
    coreutils/cat/sys/entry.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
