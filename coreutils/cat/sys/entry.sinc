// ==========================================
// coreutils/cat/sys/entry.sinc
// On-Demand CASE Artifact Reader Cell (Strict Law 15)
// ==========================================

fn main!(arena) [
    console = arena@[ARENA_LENS_CONSOLE];
    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    buf = cli@[0];
    len = cli@[1];
    if ((buf == 0) | (len == 0)) [
        ret 1;
    ]
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (shell_parse_name!(buf, 0, len, ext_buf) == 0) [
        ret 1;
    ]
    if (case_find_artifact!(arena, ext_buf@[0], ext_buf@[1], ext_buf) != 0) [
        console_print_qword!(console, STR_FS_NOT_FOUND_0, 8);
        console_print_qword!(console, STR_FS_NOT_FOUND_1, 6);
        console_newline!(console);
        ret 0;
    ]
    file_pg = ext_buf@[CASE_EXT_PG];
    file_sz = ext_buf@[CASE_EXT_BYTES];
    file_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    if (file_buf == 0) [
        ret 1;
    ]
    r_read = case_rw_pages!(arena, 0, file_pg, 1, file_buf);
    if (r_read == 0) [
        p_len = file_sz;
        if (p_len > 512) [
            p_len = 512;
        ]
        loop (b:512 = 0 .. p_len) [
            b_ch = file_buf@[b * 1];
            console_putc!(console, b_ch);
        ]
        console_newline!(console);
    ]
    exocall!(arena, EXOCALL_PMM_FREE, file_buf, 1, 0, 0);
    ret 0;
]
