// Canonical Page-Native CoW Filesystem Constants & Lenses (Strict Law 15)
// ==========================================

const CASE_MAGIC             = 1163084099;         // "CASE" (0x45534143)
const CASE_VERSION           = 1;
const CASE_SB_LBA            = 128;                // Page 16: Superblock
const CASE_BITMAP_LBA        = 136;                // Page 17: 4 KB Page Bitmap
const CASE_TABLE_LBA         = 144;                // Page 18: 64 x 64 B Artifact Table
const CASE_DATA_START_PG     = 25;                 // LBA 200+
const CASE_MAX_ENTRIES       = 64;

// Superblock Lenses (Page 16, LBA 128)
const CASE_SB_LENS_MAGIC     = 0;
const CASE_SB_LENS_VER       = 1;
const CASE_SB_LENS_GEN       = 2;
const CASE_SB_LENS_TOTAL_PG  = 3;

// Artifact Types (Fail-Fast Role Tags)
const CASE_TYPE_FREE         = 0;
const CASE_TYPE_SAFE         = 1;
const CASE_TYPE_TRG          = 2;
const CASE_TYPE_DATA         = 3;

// 64-Byte Artifact Table Entry Lenses (8 QWORDs)
// META Layout: [Type:8 | Flags:8 | Epoch:16 | Pages:32]
const CASE_LENS_META         = 0;
const CASE_LENS_START_PG     = 1;
const CASE_LENS_BYTES        = 2;
const CASE_LENS_HASH         = 3;
const CASE_LENS_RESERVED     = 4;
const CASE_LENS_NAME_0       = 5;
const CASE_LENS_NAME_1       = 6;
const CASE_LENS_OWNER        = 7;

// Shared Artifact Query Result Lenses (out_meta@[0..4])
const CASE_EXT_PG            = 0;
const CASE_EXT_PAGES         = 1;
const CASE_EXT_BYTES         = 2;
const CASE_EXT_HASH          = 3;
const CASE_EXT_META          = 4;

// FNV-1a 64-Bit Integrity Constants
const CASE_FNV_OFFSET        = -3750763034362895579;
const CASE_FNV_PRIME         = 1099511628211;

// Canonical System Artifact Names (Pure TRG Little-Endian QWORDs)
