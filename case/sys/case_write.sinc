// ==========================================
// case/sys/case_write.sinc
// Atomic CoW CASE Page Writer & Deleter (Strict Law 15)
// ==========================================

fn case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf) [
    if (sb_buf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, sb_buf, 1, 0, 0);
    ]
    if (bmp_buf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, bmp_buf, 1, 0, 0);
    ]
    if (tbl_buf != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, tbl_buf, CASE_TABLE_PAGES, 0, 0);
    ]
    ret 0;
]

fn case_load_meta!(arena, out_triple) [
    sb_buf  = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    bmp_buf = exocall!(arena, EXOCALL_PMM_ALLOC, 1, 0, 0, 0);
    tbl_buf = exocall!(arena, EXOCALL_PMM_ALLOC, CASE_TABLE_PAGES, 0, 0, 0);
    if ((sb_buf == 0) | (bmp_buf == 0) | (tbl_buf == 0)) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -1;
    ]
    r_s = exocall!(arena, EXOCALL_NVME_RW, 0, CASE_SB_LBA, 8, sb_buf);
    r_b = exocall!(arena, EXOCALL_NVME_RW, 0, CASE_BITMAP_LBA, 8, bmp_buf);
    r_t = case_rw_pages!(arena, 0, CASE_TABLE_START_PG, CASE_TABLE_PAGES, tbl_buf);
    if ((r_s != 0) | (r_b != 0) | (r_t != 0)) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -2;
    ]
    magic = sb_buf@[CASE_SB_LENS_MAGIC];
    ver   = sb_buf@[CASE_SB_LENS_VER];
    tot   = sb_buf@[CASE_SB_LENS_TOTAL_PG];
    if ((magic != CASE_MAGIC) | (ver != CASE_VERSION) | (!(tot > CASE_DATA_START_PG)) | ((bmp_buf@[0] & CASE_RESERVED_MASK) != CASE_RESERVED_MASK)) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -2;
    ]
    out_triple@[0] = sb_buf;
    out_triple@[1] = bmp_buf;
    out_triple@[2] = tbl_buf;
    ret 0;
]

fn case_flush_free_meta!(arena, sb_buf, bmp_buf, tbl_buf) [
    sb_buf@[CASE_SB_LENS_GEN] = sb_buf@[CASE_SB_LENS_GEN] + 1;
    case_rw_pages!(arena, 1, CASE_TABLE_START_PG, CASE_TABLE_PAGES, tbl_buf);
    exocall!(arena, EXOCALL_NVME_RW, 1, CASE_BITMAP_LBA, 8, bmp_buf);
    exocall!(arena, EXOCALL_NVME_RW, 1, CASE_SB_LBA, 8, sb_buf);
    case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
    ret 0;
]

fn case_write_file!(arena, type_val, name_0, name_1, data_buf, byte_len) [
    if ((type_val == CASE_TYPE_FREE) | (byte_len < 0)) [
        ret -1;
    ]
    triple = arena@[ARENA_LENS_META_BUF] + 1024;
    if (case_load_meta!(arena, triple) != 0) [
        ret -1;
    ]
    sb_buf      = triple@[0];
    bmp_buf     = triple@[1];
    tbl_buf     = triple@[2];
    total_pages = sb_buf@[CASE_SB_LENS_TOTAL_PG];

    num_pages = (byte_len + 4095) >> 12;
    if (num_pages == 0) [
        num_pages = 1;
    ]

    old_idx   = case_lookup(tbl_buf, name_0, name_1);
    old_pg    = 0;
    old_pages = 0;
    new_epoch = 1;
    entry_idx = old_idx;

    if (old_idx < 0) [
        entry_idx = case_find_free_entry(tbl_buf);
        if (entry_idx < 0) [
            case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
            ret -3;
        ]
    ]
    if (!(old_idx < 0)) [
        old_base  = old_idx << 3;
        old_meta  = tbl_buf@[(old_base + CASE_LENS_META)];
        old_pg    = tbl_buf@[(old_base + CASE_LENS_START_PG)];
        old_pages = case_entry_pages(old_meta);
        new_epoch = case_entry_epoch(old_meta) + 1;
    ]

    new_pg = case_alloc_pages!(bmp_buf, total_pages, num_pages);
    if (new_pg < 0) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -3;
    ]

    r_w = case_rw_pages!(arena, 1, new_pg, num_pages, data_buf);
    if (r_w != 0) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -4;
    ]

    hash_val = case_fnv1a_64(data_buf, byte_len);
    case_set_entry!(tbl_buf, entry_idx, type_val, new_epoch, num_pages, new_pg, byte_len, hash_val, name_0, name_1);
    if (!(old_idx < 0)) [
        case_mark_pages!(bmp_buf, old_pg, old_pages, 0);
    ]
    case_flush_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
    ret 0;
]

fn case_delete_file!(arena, name_0, name_1) [
    triple = arena@[ARENA_LENS_META_BUF] + 1024;
    if (case_load_meta!(arena, triple) != 0) [
        ret -1;
    ]
    sb_buf  = triple@[0];
    bmp_buf = triple@[1];
    tbl_buf = triple@[2];

    idx = case_lookup(tbl_buf, name_0, name_1);
    if (idx < 0) [
        case_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
        ret -3;
    ]

    base  = idx << 3;
    meta  = tbl_buf@[(base + CASE_LENS_META)];
    pg    = tbl_buf@[(base + CASE_LENS_START_PG)];
    pages = case_entry_pages(meta);
    case_mark_pages!(bmp_buf, pg, pages, 0);
    case_clear_entry!(tbl_buf, idx);
    case_flush_free_meta!(arena, sb_buf, bmp_buf, tbl_buf);
    ret 0;
]
