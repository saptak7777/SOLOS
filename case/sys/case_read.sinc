// ==========================================
// case/sys/case_read.sinc
// Read-Only Exocall CASE Page I/O & Artifact Lookup (Strict Law 15)
// ==========================================

extern fn exocall!();

fn case_rw_pages!(arena, is_write, start_pg, num_pages, buf) [
    if (num_pages == 0) [
        ret 0;
    ]
    err = 0;
    loop (c:512 = 0 .. num_pages) [
        if (err == 0) [
            cur_lba = (start_pg + c) << 3;
            ptr = buf + (c << 12);
            r = exocall!(arena, EXOCALL_NVME_RW, is_write, cur_lba, 8, ptr);
            if (r != 0) [
                err = r;
            ]
        ]
    ]
    ret err;
]

fn case_find_artifact!(arena, name_0, name_1, out_meta) [
    tbl_buf = exocall!(arena, EXOCALL_PMM_ALLOC, CASE_TABLE_PAGES, 0, 0, 0);
    if (tbl_buf == 0) [
        ret -1;
    ]
    r_tbl = case_rw_pages!(arena, 0, CASE_TABLE_START_PG, CASE_TABLE_PAGES, tbl_buf);
    if (r_tbl != 0) [
        exocall!(arena, EXOCALL_PMM_FREE, tbl_buf, CASE_TABLE_PAGES, 0, 0);
        ret -2;
    ]
    idx = case_lookup(tbl_buf, name_0, name_1);
    if (idx < 0) [
        exocall!(arena, EXOCALL_PMM_FREE, tbl_buf, CASE_TABLE_PAGES, 0, 0);
        ret -3;
    ]
    base = idx << 3;
    meta = tbl_buf@[(base + CASE_LENS_META)];
    out_meta@[CASE_EXT_PG]    = tbl_buf@[(base + CASE_LENS_START_PG)];
    out_meta@[CASE_EXT_PAGES] = case_entry_pages(meta);
    out_meta@[CASE_EXT_BYTES] = tbl_buf@[(base + CASE_LENS_BYTES)];
    out_meta@[CASE_EXT_HASH]  = tbl_buf@[(base + CASE_LENS_HASH)];
    out_meta@[CASE_EXT_META]  = meta;
    exocall!(arena, EXOCALL_PMM_FREE, tbl_buf, CASE_TABLE_PAGES, 0, 0);
    ret 0;
]
