// ==========================================
// lit_shell/sys/entry.sinc
// Sovereign LIT Interactive Shell Cell (Strict Law 15)
// ==========================================

fn shell_dispatch_cell!(arena, buf, len) [
    console = arena@[ARENA_LENS_CONSOLE];
    w_len = shell_get_word_len(buf, 0, len);
    name_buf = arena@[ARENA_LENS_META_BUF] + 576;
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;

    found = 0;
    if (cmd_append_ext!(buf, w_len, CASE_SAFE_EXT_PACKED, name_buf) != 0) [
        if (case_find_artifact!(arena, name_buf@[0], name_buf@[1], ext_buf) == 0) [
            if (case_entry_type(ext_buf@[CASE_EXT_META]) == CASE_TYPE_SAFE) [
                found = 1;
            ]
        ]
    ]

    if (found == 0) [
        console_print_qword!(console, STR_UNKNOWN_CMD_0, 8);
        console_print_qword!(console, STR_UNKNOWN_CMD_1, 8);
        console_print_qword!(console, STR_UNKNOWN_CMD_2, 8);
        console_print_qword!(console, STR_UNKNOWN_CMD_3, 3);
        console_newline!(console);
        ret 0;
    ]

    table = arena@[ARENA_LENS_LIT_TABLE];
    cmd_slot = slot_find_free_high(table);
    if (cmd_slot < 0) [
        console_print_qword!(console, STR_FAIL_TAG_0, 6);
        console_newline!(console);
        ret 0;
    ]

    lba = ext_buf@[CASE_EXT_PG] << 3;
    secs = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_val = ext_buf@[CASE_EXT_HASH];
    if (exocall!(arena, EXOCALL_SLOT_LOAD, cmd_slot, lba, secs, hash_val) != LIT_EXIT_OK) [
        console_print_qword!(console, STR_FAIL_TAG_0, 6);
        console_newline!(console);
        ret 0;
    ]

    cli = arena@[ARENA_LENS_META_BUF] + META_CLI_ARGS_OFF;
    idx_arg = shell_skip_word(buf, 0, len);
    cli@[0] = buf + idx_arg;
    cli@[1] = len - idx_arg;

    exocall!(arena, EXOCALL_SLOT_CALL, cmd_slot, arena, 0, 0);
    exocall!(arena, EXOCALL_SLOT_UNLOAD, cmd_slot, 0, 0, 0);
    cli@[0] = 0;
    cli@[1] = 0;
    ret 0;
]

fn shell_load_or_swap!(arena, buf, len, is_swap) [
    console = arena@[ARENA_LENS_CONSOLE];
    idx1 = shell_skip_word(buf, 0, len);
    ext_buf = arena@[ARENA_LENS_META_BUF] + 512;
    if (shell_parse_name!(buf, idx1, len, ext_buf) == 0) [
        ret 0;
    ]
    if (case_find_artifact!(arena, ext_buf@[0], ext_buf@[1], ext_buf) != 0) [
        console_print_qword!(console, STR_FS_NOT_FOUND_0, 8);
        console_print_qword!(console, STR_FS_NOT_FOUND_1, 6);
        console_newline!(console);
        ret 0;
    ]
    if (case_entry_type(ext_buf@[CASE_EXT_META]) != CASE_TYPE_SAFE) [
        console_print_qword!(console, STR_FAIL_TAG_0, 6);
        console_newline!(console);
        ret 0;
    ]
    idx2 = shell_skip_word(buf, idx1, len);
    slot = shell_parse_dec(buf, idx2, len);
    lba = ext_buf@[CASE_EXT_PG] << 3;
    secs = ext_buf@[CASE_EXT_PAGES] << 3;
    hash_val = ext_buf@[CASE_EXT_HASH];
    op = EXOCALL_SLOT_LOAD;
    if (is_swap != 0) [
        op = EXOCALL_SLOT_HOTSWAP;
    ]
    r = exocall!(arena, op, slot, lba, secs, hash_val);
    console_print_qword!(console, STR_RES_TAG_0, 5);
    console_print_dec!(console, r);
    console_newline!(console);
    ret 0;
]

fn shell_execute_line!(arena, scratch, buf, len) [
    console = arena@[ARENA_LENS_CONSOLE];
    if (len == 0) [
        ret 0;
    ]

    cmd = shell_match_cmd(buf, len);

    if (cmd == CMD_HELP) [
        console_print_qword!(console, STR_HELP_MSG_0, 8);
        console_print_qword!(console, STR_HELP_MSG_1, 8);
        console_print_qword!(console, STR_HELP_MSG_2, 8);
        console_print_qword!(console, STR_HELP_MSG_3, 8);
        console_print_qword!(console, STR_HELP_MSG_4, 8);
        console_print_qword!(console, STR_HELP_MSG_5, 8);
        console_print_qword!(console, STR_HELP_MSG_6, 8);
        console_print_qword!(console, STR_HELP_MSG_7, 8);
        console_print_qword!(console, STR_HELP_MSG_8, 8);
        console_print_qword!(console, STR_HELP_MSG_9, 6);
        console_newline!(console);
        ret 0;
    ]

    if (cmd == CMD_MEM) [
        pmm = arena@[ARENA_LENS_PMM];
        free_pgs = pmm@[PMM_LENS_FREE_PAGES];
        max_pgs = pmm@[PMM_LENS_MAX_PAGE];
        console_print_qword!(console, STR_PMM_FREE_0, 8);
        console_print_qword!(console, STR_PMM_FREE_1, 4);
        console_print_dec!(console, free_pgs);
        console_print_qword!(console, STR_PMM_MAX_0, 8);
        console_print_dec!(console, max_pgs);
        console_newline!(console);
        ret 0;
    ]

    if (cmd == CMD_TIME) [
        timer = arena@[ARENA_LENS_TIMER];
        ticks = timer@[0];
        console_print_qword!(console, STR_TIME_TAG_0, 7);
        console_print_dec!(console, ticks);
        console_newline!(console);
        ret 0;
    ]

    if (cmd == CMD_SLOTS) [
        table = arena@[ARENA_LENS_LIT_TABLE];
        loop (s:64 = 0 .. 64) [
            if (slot_is_occupied(table, s) != 0) [
                h = slot_get_hash(table, s);
                p = slot_get_pages(table, s);
                console_print_qword!(console, STR_SLOT_TAG_0, 5);
                console_print_dec!(console, s);
                console_print_qword!(console, STR_HASH_TAG_0, 7);
                console_print_dec!(console, h);
                console_print_qword!(console, STR_PAGES_TAG_0, 6);
                console_print_dec!(console, p);
                console_newline!(console);
            ]
        ]
        ret 0;
    ]

    if (cmd == CMD_CLEAR) [
        console_clear!(console);
        ret 0;
    ]

    if (cmd == CMD_QUIT) [
        scratch@[SCRATCH_LENS_RUNNING] = 0;
        ret 0;
    ]

    if (cmd == CMD_LOAD) [
        ret shell_load_or_swap!(arena, buf, len, 0);
    ]

    if (cmd == CMD_CALL) [
        idx1 = shell_skip_word(buf, 0, len);
        slot = shell_parse_dec(buf, idx1, len);
        idx2 = shell_skip_word(buf, idx1, len);
        arg = shell_parse_dec(buf, idx2, len);
        r = exocall!(arena, EXOCALL_SLOT_CALL, slot, arg, 0, 0);
        console_print_qword!(console, STR_RES_TAG_0, 5);
        console_print_dec!(console, r);
        console_newline!(console);
        ret 0;
    ]

    if (cmd == CMD_SWAP) [
        ret shell_load_or_swap!(arena, buf, len, 1);
    ]

    if (cmd == CMD_UNLOAD) [
        idx1 = shell_skip_word(buf, 0, len);
        slot = shell_parse_dec(buf, idx1, len);
        r = exocall!(arena, EXOCALL_SLOT_UNLOAD, slot, 0, 0, 0);
        console_print_qword!(console, STR_RES_TAG_0, 5);
        console_print_dec!(console, r);
        console_newline!(console);
        ret 0;
    ]

    ret shell_dispatch_cell!(arena, buf, len);
]

fn shell_handle_input_evt!(arena, scratch, evt) [
    if (input_evt_type(evt) != EVT_KEY_DOWN) [
        ret 0;
    ]
    console = arena@[ARENA_LENS_CONSOLE];
    trg = input_evt_key(evt);
    if ((trg < 0) | (trg == TRG_NONE)) [
        ret 0;
    ]

    line_len = scratch@[SCRATCH_LENS_LINE_LEN];
    buf_base = scratch + (SCRATCH_LENS_LINE_BUF << 3);

    // Enter / Return
    if (trg == TRG_RET) [
        console@[CONSOLE_LENS_STREAM_BUF] = scratch;
        console_newline!(console);
        shell_execute_line!(arena, scratch, buf_base, line_len);
        scratch@[SCRATCH_LENS_LINE_LEN] = 0;
        if (scratch@[SCRATCH_LENS_RUNNING] != 0) [
            console_print_qword!(console, STR_SHELL_PROMPT_0, 2);
        ]
        console@[CONSOLE_LENS_STREAM_BUF] = 0;
        ret 0;
    ]

    // Backspace
    if (trg == TRG_BS) [
        if (line_len > 0) [
            scratch@[SCRATCH_LENS_LINE_LEN] = line_len - 1;
        ]
        ret 0;
    ]

    // Regular printable character (allow 0..232, TRG_SPC=240, and 243..255 punctuation)
    is_ctrl = ((!(trg < TRG_ESC)) & (trg < TRG_SPC)) | (trg == TRG_RET) | (trg == TRG_TAB);
    if ((line_len < 64) & (is_ctrl == 0)) [
        buf_base@[line_len * 1] = trg;
        scratch@[SCRATCH_LENS_LINE_LEN] = line_len + 1;
    ]
    ret 0;
]

fn shell_trim_stream!(st) [
    pos = st@[PANE_ST_STREAM_POS];
    if (!(pos > 1536)) [ ret 0; ]
    ptr = st@[PANE_ST_STREAM_PTR];
    cut = pos - 768;
    found = 0;
    loop (i:1024 = 0 .. 768) [
        if ((found == 0) & ((cut + i) < pos)) [
            if ((ptr@[(cut + i) * 1] & 255) == TRG_RET) [
                cut = cut + i + 1;
                found = 1;
            ]
        ]
    ]
    rem = pos - cut;
    loop (k:1536 = 0 .. rem) [
        ptr@[k * 1] = ptr@[(cut + k) * 1];
    ]
    st@[PANE_ST_STREAM_POS] = rem;
    ret 0;
]

fn shell_emit_vis_row!(disp_ctrl, st, cx, cy, cur_row, cur_col) [
    skip_rows = st@[PANE_ST_SKIP_ROWS];
    max_rows  = st@[PANE_ST_MAX_ROWS];
    if ((cur_row < skip_rows) | (!((cur_row - skip_rows) < max_rows)) | (cur_col < 1)) [
        ret 0;
    ]
    vis  = cur_row - skip_rows;
    rbuf = st + PANE_ST_ROWS_OFF + (vis << 7);
    rect = st@[PANE_ST_CLIP_RECT];
    sagr_ring_push!(disp_ctrl, sagr_pack_hdr(SAGR_CMD_GLYPH_RUN, SAGR_FLAG_CLIP, cx + 6, cy + 4 + (vis << 4)), sagr_pack_ext(cur_col, 1, PANE_ST_COL_FG), rbuf, rect);
    ret 0;
]

fn shell_walk_lines!(arena, st, cx, cy, max_cols, do_emit) [
    disp_ctrl = arena@[ARENA_LENS_DISPLAY];
    pos       = st@[PANE_ST_STREAM_POS];
    text_buf  = st@[PANE_ST_STREAM_PTR];
    line_len  = st@[SCRATCH_LENS_LINE_LEN];
    line_buf  = st + (SCRATCH_LENS_LINE_BUF << 3);
    skip_rows = st@[PANE_ST_SKIP_ROWS];
    max_rows  = st@[PANE_ST_MAX_ROWS];
    rect      = st@[PANE_ST_CLIP_RECT];
    total     = pos + line_len;
    if (total > 4096) [ total = 4096; ]

    cur_row = 0;
    cur_col = 0;
    loop (idx:4096 = 0 .. total) [
        ch = 0;
        if (idx < pos) [ ch = text_buf@[idx * 1] & 255; ]
        if (!(idx < pos)) [ ch = line_buf@[(idx - pos) * 1] & 255; ]
        if (ch == TRG_RET) [
            if (do_emit != 0) [ shell_emit_vis_row!(disp_ctrl, st, cx, cy, cur_row, cur_col); ]
            cur_row = cur_row + 1;
            cur_col = 0;
        ]
        if (ch != TRG_RET) [
            if (!(cur_col < max_cols)) [
                if (do_emit != 0) [ shell_emit_vis_row!(disp_ctrl, st, cx, cy, cur_row, cur_col); ]
                cur_row = cur_row + 1;
                cur_col = 0;
            ]
            if (do_emit != 0) [
                vis = cur_row - skip_rows;
                if ((!(cur_row < skip_rows)) & (vis < max_rows) & (cur_col < 110)) [
                    rbuf = st + PANE_ST_ROWS_OFF + (vis << 7);
                    rbuf@[cur_col * 1] = ch;
                ]
            ]
            cur_col = cur_col + 1;
        ]
    ]

    if (do_emit != 0) [
        shell_emit_vis_row!(disp_ctrl, st, cx, cy, cur_row, cur_col);
        if (st@[PANE_ST_FOCUSED] != 0) [
            vis = cur_row - skip_rows;
            if ((!(cur_row < skip_rows)) & (vis < max_rows)) [
                sagr_ring_push!(disp_ctrl, sagr_pack_hdr(SAGR_CMD_RECT, SAGR_FLAG_CLIP, cx + 6 + (cur_col << 3), cy + 5 + (vis << 4)), sagr_pack_ext(2, 14, PANE_ST_COL_CURSOR), 0, rect);
            ]
        ]
    ]
    ret cur_row + 1;
]

fn shell_pane_init!(arena, pkt) [
    st = exocall!(arena, EXOCALL_PMM_ALLOC, PANE_ST_PAGES, 0, 0, 0);
    if (st == 0) [ ret 0; ]
    loop (z:64 = 0 .. 64) [ st@[z] = 0; ]
    st@[PANE_ST_STREAM_POS]   = 0;
    st@[PANE_ST_STREAM_CAP]   = PANE_ST_TEXT_CAP;
    st@[PANE_ST_STREAM_PTR]   = st + PANE_ST_TEXT_OFF;
    st@[SCRATCH_LENS_RUNNING] = 1;
    st@[SCRATCH_LENS_LINE_LEN] = 0;

    console = arena@[ARENA_LENS_CONSOLE];
    console@[CONSOLE_LENS_STREAM_BUF] = st;
    console_print_qword!(console, STR_SHELL_BANNER_0, 8);
    console_print_qword!(console, STR_SHELL_BANNER_1, 8);
    console_print_qword!(console, STR_SHELL_BANNER_2, 8);
    console_print_qword!(console, STR_SHELL_BANNER_3, 2);
    console_newline!(console);
    console_print_qword!(console, STR_SHELL_PROMPT_0, 2);
    console@[CONSOLE_LENS_STREAM_BUF] = 0;

    pkt@[PANE_PKT_TITLE] = STR_SHELL_TITLE;
    ret st;
]

fn shell_pane_render!(arena, st, pkt) [
    disp_ctrl = arena@[ARENA_LENS_DISPLAY];
    rect      = pkt@[PANE_PKT_ARG0];
    cx        = sagr_sext16(sagr_cmd_x(rect));
    cy        = sagr_sext16(sagr_cmd_y(rect));
    cw        = sagr_cmd_w(rect);
    ch        = sagr_cmd_h(rect);
    pkt@[PANE_PKT_TITLE] = STR_SHELL_TITLE;

    sagr_ring_push!(disp_ctrl, sagr_pack_hdr(SAGR_CMD_RECT, SAGR_FLAG_CLIP, cx, cy), sagr_pack_ext(cw, ch, PANE_ST_COL_BG), 0, rect);
    max_cols = (cw - 12) >> 3;
    if (max_cols < 4)   [ max_cols = 4; ]
    if (max_cols > 110) [ max_cols = 110; ]
    max_rows = (ch - 8) >> 4;
    if (max_rows < 1)  [ max_rows = 1; ]
    if (max_rows > 40) [ max_rows = 40; ]

    st@[PANE_ST_CLIP_RECT] = rect;
    st@[PANE_ST_MAX_ROWS]  = max_rows;
    st@[PANE_ST_FOCUSED]   = pkt@[PANE_PKT_ARG1];
    st@[PANE_ST_SKIP_ROWS] = 0;

    total_rows = shell_walk_lines!(arena, st, cx, cy, max_cols, 0);
    skip = total_rows - max_rows;
    if (skip < 0) [ skip = 0; ]
    st@[PANE_ST_SKIP_ROWS] = skip;
    shell_walk_lines!(arena, st, cx, cy, max_cols, 1);
    ret 0;
]

fn main!(pkt) [
    if (pkt == 0) [ ret 0; ]
    op    = pkt@[PANE_PKT_OP];
    arena = pkt@[PANE_PKT_ARENA];
    st    = pkt@[PANE_PKT_STATE];
    if (arena == 0) [ ret 0; ]

    if (op == PANE_OP_INIT) [
        ret shell_pane_init!(arena, pkt);
    ]
    if (op == PANE_OP_EVENT) [
        if (st == 0) [ ret 0; ]
        shell_handle_input_evt!(arena, st, pkt@[PANE_PKT_ARG0]);
        shell_trim_stream!(st);
        if (st@[SCRATCH_LENS_RUNNING] == 0) [ ret 1; ]
        ret 0;
    ]
    if (op == PANE_OP_RENDER) [
        if (st != 0) [ shell_pane_render!(arena, st, pkt); ]
        ret 0;
    ]
    if (op == PANE_OP_FREE) [
        if (st != 0) [ exocall!(arena, EXOCALL_PMM_FREE, st, PANE_ST_PAGES, 0, 0); ]
        ret 0;
    ]
    ret 0;
]
