const KBD_UNSHIFT_6 = 8281965774451910427;  // slots: [27, 39, 38, 252, 253, 115, 239, 114]
const KBD_UNSHIFT_7 = -1157442765409226513; // slots: [239, 240, 239, 239, 239, 239, 239, 239]

