// ==========================================
// lit_shell/pure/input.sinc
// Pure PS/2 Keyboard Scancode to TRG Decoder (Strict Law 15)
// ==========================================

fn trg_is_break_code(scancode) [
    if ((scancode & 128) != 0) [
        ret 1;
    ]
    ret 0;
]

fn trg_update_shift_state(scancode, current_shift) [
    if ((scancode == 42) | (scancode == 54)) [
        ret 1;
    ]
    if ((scancode == 170) | (scancode == 182)) [
        ret 0;
    ]
    ret current_shift;
]

fn trg_kbd_qw(qw_idx, shift) [
    if (shift == 0) [
        if (qw_idx == 3) [
            ret KBD_UNSHIFT_3;
        ]
        if (qw_idx == 7) [
            ret KBD_UNSHIFT_7;
        ]
        if (qw_idx == 0) [
            ret KBD_UNSHIFT_0;
        ]
        if (qw_idx == 1) [
            ret KBD_UNSHIFT_1;
        ]
        if (qw_idx == 2) [
            ret KBD_UNSHIFT_2;
        ]
        if (qw_idx == 4) [
            ret KBD_UNSHIFT_4;
        ]
        if (qw_idx == 5) [
            ret KBD_UNSHIFT_5;
        ]
        ret KBD_UNSHIFT_6;
    ]
    if (qw_idx == 3) [
        ret KBD_SHIFT_3;
    ]
    if (qw_idx == 0) [
        ret KBD_SHIFT_0;
    ]
    if (qw_idx == 1) [
        ret KBD_SHIFT_1;
    ]
    if (qw_idx == 2) [
        ret KBD_SHIFT_2;
    ]
    if (qw_idx == 4) [
        ret KBD_SHIFT_4;
    ]
    if (qw_idx == 5) [
        ret KBD_SHIFT_5;
    ]
    if (qw_idx == 6) [
        ret KBD_SHIFT_6;
    ]
    ret KBD_SHIFT_7;
]

fn trg_scancode_to_trg(scancode, shift) [
    if (((scancode & 128) != 0) | (!(scancode < 64))) [
        ret -1;
    ]
    qw = trg_kbd_qw(scancode >> 3, shift);
    shift_amt = (scancode & 7) << 3;
    code = (qw >> shift_amt) & 255;
    if (code == TRG_NONE) [
        ret -1;
    ]
    ret code;
]

