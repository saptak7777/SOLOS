// ==========================================
// lit_shell/build.staff
// LIT Shell Sovereign Application Manifest
// ==========================================

artifact lit_shell [
    target = x86_64_none;
    type   = bin;
]

deps [
    spine/data/abi_defs.sinc;
    spine/data/cli_defs.sinc;
    spine/data/input_defs.sinc;
    spine/pure/cmd_line.sinc;
    spine/pure/input_evt.sinc;
    lit/data/lit_defs.sinc;
    lit/pure/slots.sinc;
    case/data/case_defs.sinc;
    case/pure/case.sinc;
    case/sys/case_read.sinc;
    shark/data/console_defs.sinc;
    shark/data/input_defs.sinc;
    shark/pure/math.sinc;
    shark/sys/ring.sinc;
    shark/sys/console.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
